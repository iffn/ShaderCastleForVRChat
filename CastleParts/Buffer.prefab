        <color=#569CD6>float3</color> lightColor = _LightColor0.rgb;\r\n               
        <color=#569CD6>half3</color> ambientLight = UNITY_LIGHTMODEL_AMBIENT.rgb;\r\n               
        <color=#569CD6>half3</color> NdotL = dot(worldNormal, _world_light_direction);\r\n               
