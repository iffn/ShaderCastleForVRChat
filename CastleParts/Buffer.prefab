    - target: {fileID: 7367256946062963377, guid: a5d268ebcd856454399c77a1c6b9c2a6,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/Stencil/StencilBasicWrite\"</color>\r\n{\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        Tags { <color=#D69D85>\"RenderType\"</color>=<color=#D69D85>\"Opaque\"</color>
        <color=#D69D85>\"Queue\"</color>=<color=#D69D85>\"Geometry-1\"</color> }
        <color=#57A64A>// Runs before geometry\r</color>\n\r\n        ColorMask 0\r\n       
        ZWrite Off\r\n\r\n        <color=#569CD6>Pass</color> {\r\n            Stencil
        {\r\n                Ref 1 <color=#57A64A>// What values are being written:            
        xxxx xxx1 (x doesn't matter because of the mask)\r</color>\n               
        WriteMask 1 <color=#57A64A>// Only the last bit should be changed: 0000 0001\r</color>\n               
        Comp Always\r\n                <color=#569CD6>Pass</color> Replace\r\n           
        }\r\n        }\r\n    }\r\n}"
      objectReference: {fileID: 0}
