      objectReference: {fileID: 0}
    - target: {fileID: 5462205145252323058, guid: aacf23fd940d08d419d1dcbc7feb3a70,
        type: 3}
      propertyPath: description
      value: The Blinn-Phong model is an adjustment made by Jim Blinn to the Phong
        model in 1977. Instead of creating inaccurate highlights at shallow 'grazing'
        angles, it uses the normal and half vector to improve this.
      objectReference: {fileID: 0}
