    - target: {fileID: 1646632789100472694, guid: b73eb1b3c6e2e0d4cafdd26f05d39817,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/Basics/UVCoordinate\"</color>\r\n{\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        <color=#569CD6>Pass</color>\r\n       
        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n            #pragma
        <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n\r\n            <color=#57A64A>// Mesh to vertex transfer data\r</color>\n           
        <color=#569CD6>struct</color> <color=#569CD6>appdata</color> {\r\n               
        <color=#569CD6>float4</color> <color=#569CD6>vertex</color> : POSITION;\r\n               
        <color=#569CD6>float2</color> uv : TEXCOORD0; <color=#57A64A>// Access to
        uv values\r</color>\n            };\r\n\r\n            <color=#57A64A>//
        Vertex to fragment transfer data\r</color>\n            <color=#569CD6>struct</color>
        <color=#569CD6>v2f</color> {\r\n                <color=#569CD6>float4</color>
        pos : SV_POSITION;\r\n                <color=#569CD6>float2</color> uv :
        TEXCOORD0; <color=#57A64A>// UV transfer data\r</color>\n            };\r\n\r\n           
        <color=#57A64A>// Vertex function\r</color>\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n                o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        o.uv = v.uv; <color=#57A64A>// Directly transfering uv values from mesh to
        fragment\r</color>\n                return o;\r\n            }\r\n\r\n           
        <color=#57A64A>// Fragment function accessing the UV values\r</color>\n           
        <color=#569CD6>half4</color> frag (<color=#569CD6>v2f</color> i) : SV_Target
        {\r\n                <color=#569CD6>half3</color> color = <color=#569CD6>half3</color>(i.uv,
        0.0);\r\n                return <color=#569CD6>half4</color>(color, 1.0);\r\n           
        }\r\n            <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 2144881539648616297, guid: b73eb1b3c6e2e0d4cafdd26f05d39817,
