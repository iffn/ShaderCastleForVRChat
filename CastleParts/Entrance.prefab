    - target: {fileID: 529462110852979781, guid: 66745b262687c404d85002fd5521f7dc,
        type: 3}
      propertyPath: m_Text
      value: "Shader \"ShaderCastle/Tutorials/VertexShader/CullFront\"\r\n{\r\n   
        SubShader\r\n    {\r\n        Pass\r\n        {\r\n            Cull Front
        // Cull = 'Skip drawing' when looking from this side\r\n            CGPROGRAM\r\n           
        #pragma vertex vert\r\n            #pragma fragment frag\r\n            \r\n\r\n           
        struct appdata {\r\n                float4 vertex : POSITION;\r\n           
        };\r\n\r\n            struct v2f {\r\n                float4 pos : SV_POSITION;\r\n           
        };\r\n\r\n            v2f vert (appdata v) {\r\n                v2f o;\r\n\r\n               
        float xOffset = v.vertex.x;\r\n                v.vertex.x = xOffset * sin(_Time.y);\r\n               
        v.vertex.z = xOffset * cos(_Time.y);\r\n\r\n                o.pos = UnityObjectToClipPos(v.vertex);\r\n               
        return o;\r\n            }\r\n\r\n            half4 frag () : SV_Target {\r\n               
        half3 color = half3(1.0, 0.0, 0.0);\r\n                return half4(color,
        1.0);\r\n            }\r\n            ENDCG\r\n        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 623719149371153107, guid: 66745b262687c404d85002fd5521f7dc,
        type: 3}
      propertyPath: m_AnchorMax.y
