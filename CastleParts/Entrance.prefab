    - target: {fileID: 2762484652437298491, guid: 66745b262687c404d85002fd5521f7dc,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/VertexShader/CullBack\"</color>\r\n{\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        <color=#569CD6>Pass</color>\r\n       
        {\r\n            Cull Back <color=#57A64A>// Cull = 'Skip drawing' when looking
        from this side\r</color>\n            <color=#569CD6>CGPROGRAM</color>\r\n           
        #pragma <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            \r\n\r\n            <color=#569CD6>struct</color> <color=#569CD6>appdata</color>
        {\r\n                <color=#569CD6>float4</color> <color=#569CD6>vertex</color>
        : POSITION;\r\n            };\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>v2f</color> {\r\n                <color=#569CD6>float4</color>
        pos : SV_POSITION;\r\n            };\r\n\r\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n                \r\n                <color=#569CD6>float</color> xOffset
        = v.<color=#569CD6>vertex</color>.x;\r\n                v.<color=#569CD6>vertex</color>.x
        = xOffset * sin(_Time.y);\r\n                v.<color=#569CD6>vertex</color>.z
        = xOffset * cos(_Time.y);\r\n\r\n                o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        return o;\r\n            }\r\n\r\n            <color=#569CD6>half4</color>
        frag () : SV_Target {\r\n                <color=#569CD6>half3</color> color
        = <color=#569CD6>half3</color>(1.0, 0.0, 0.0); <color=#57A64A>// Red\r</color>\n               
        return <color=#569CD6>half4</color>(color, 1.0);\r\n            }\r\n           
        <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
