    - target: {fileID: 8914915987554601311, guid: 66745b262687c404d85002fd5521f7dc,
        type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8914915987554601311, guid: 66745b262687c404d85002fd5521f7dc,
        type: 3}
      propertyPath: m_AnchoredPosition.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8931661560263053802, guid: 66745b262687c404d85002fd5521f7dc,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/VertexShader/Billboard\"</color>\r\n{\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        <color=#569CD6>Pass</color>\r\n       
        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n            #pragma
        <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            \r\n            #include <color=#D69D85>\"UnityCG.cginc\"</color>\r\n\r\n           
        <color=#569CD6>struct</color> <color=#569CD6>appdata</color> {\r\n               
        <color=#569CD6>float4</color> <color=#569CD6>vertex</color> : POSITION;\r\n           
        };\r\n\r\n            <color=#569CD6>struct</color> <color=#569CD6>v2f</color>
        {\r\n                <color=#569CD6>float4</color> pos : SV_POSITION;\r\n           
        };\r\n\r\n            <color=#569CD6>v2f</color> vert (<color=#569CD6>appdata</color>
        v) {\r\n                <color=#569CD6>v2f</color> o;\r\n\r\n               
        float4x4 objectToWorld = unity_ObjectToWorld;\r\n\r\n                <color=#569CD6>float</color>
        viewScaleX = length(<color=#569CD6>float3</color>(objectToWorld._m00, objectToWorld._m10,
        objectToWorld._m20));\r\n                <color=#569CD6>float</color> viewScaleY
        = length(<color=#569CD6>float3</color>(objectToWorld._m01, objectToWorld._m11,
        objectToWorld._m21));\r\n                \r\n                <color=#569CD6>float4</color>
        viewPosition = <color=#569CD6>float4</color>(v.<color=#569CD6>vertex</color>.x
        * viewScaleX, v.<color=#569CD6>vertex</color>.y * viewScaleY, 0, 0);\r\n\r\n               
        <color=#569CD6>float4</color> viewSpaceCenter = mul(UNITY_MATRIX_MV, <color=#569CD6>float4</color>(0,
        0, 0, 1));\r\n                <color=#569CD6>float4</color> viewPos = viewSpaceCenter
        + viewPosition;\r\n\r\n                o.pos = mul(UNITY_MATRIX_P, viewPos);\r\n               
        \r\n                return o;\r\n            }\r\n\r\n            <color=#569CD6>half4</color>
        frag () : SV_Target {\r\n                <color=#569CD6>half3</color> color
        = <color=#569CD6>half3</color>(1.0, 0.0, 0.0); <color=#57A64A>// Red\r</color>\n               
        return <color=#569CD6>half4</color>(color, 1.0);\r\n            }\r\n           
        <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8939861022127333356, guid: 66745b262687c404d85002fd5521f7dc,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/VertexShader/VertexSpin\"</color>\r\n{\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        <color=#569CD6>Pass</color>\r\n       
        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n            #pragma
        <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            \r\n\r\n            <color=#569CD6>struct</color> <color=#569CD6>appdata</color>
        {\r\n                <color=#569CD6>float4</color> <color=#569CD6>vertex</color>
        : POSITION;\r\n            };\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>v2f</color> {\r\n                <color=#569CD6>float4</color>
        pos : SV_POSITION;\r\n            };\r\n\r\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n\r\n                <color=#569CD6>float</color> xOffset = v.<color=#569CD6>vertex</color>.x;\r\n               
        <color=#569CD6>float</color> zOffset = v.<color=#569CD6>vertex</color>.z;\r\n\r\n               
        <color=#569CD6>float</color> sinTime = sin(_Time.y);\r\n                <color=#569CD6>float</color>
        cosTime = cos(_Time.y);\r\n\r\n                v.<color=#569CD6>vertex</color>.x
        = xOffset * cosTime + zOffset * sinTime;\r\n                v.<color=#569CD6>vertex</color>.z
        = -xOffset * sinTime + zOffset * cosTime;\r\n                \r\n               
        o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        return o;\r\n            }\r\n\r\n            <color=#569CD6>half4</color>
        frag () : SV_Target {\r\n                <color=#569CD6>half3</color> color
        = <color=#569CD6>half3</color>(1.0, 0.0, 0.0);\r\n                return
        <color=#569CD6>half4</color>(color, 1.0);\r\n            }\r\n           
        <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}\r\n"
