    - target: {fileID: 4623599885207642893, guid: b73eb1b3c6e2e0d4cafdd26f05d39817,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/Light/LocalNormals\"</color>\r\n{\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        <color=#569CD6>Pass</color>\r\n       
        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n            #pragma
        <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n\r\n            <color=#569CD6>struct</color> <color=#569CD6>appdata</color>
        {\r\n                <color=#569CD6>float4</color> <color=#569CD6>vertex</color>
        : POSITION;\r\n                <color=#569CD6>float3</color> normal : NORMAL;\r\n           
        };\r\n\r\n            <color=#569CD6>struct</color> <color=#569CD6>v2f</color>
        {\r\n                <color=#569CD6>float4</color> pos : SV_POSITION;\r\n               
        <color=#569CD6>float3</color> normal : TEXCOORD0;\r\n            };\r\n\r\n           
        <color=#569CD6>v2f</color> vert (<color=#569CD6>appdata</color> v) {\r\n               
        <color=#569CD6>v2f</color> o;\r\n                o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        o.normal = v.normal;\r\n                return o;\r\n            }\r\n\r\n           
        <color=#569CD6>half4</color> frag (<color=#569CD6>v2f</color> i) : SV_Target
        {\r\n                <color=#569CD6>half3</color> color = <color=#569CD6>half3</color>(i.normal);\r\n               
        return <color=#569CD6>half4</color>(color, 1.0);\r\n            }\r\n           
        <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
