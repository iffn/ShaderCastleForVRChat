    - target: {fileID: 6628211061730501555, guid: e22c1831a6e25ff4999ccd41af9a55c5,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/GrabPass/BasicGrabPass\"</color>\r\n{\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        Tags { <color=#D69D85>\"Queue\"</color>=<color=#D69D85>\"Transparent+500\"</color>
        <color=#D69D85>\"RenderType\"</color>=<color=#D69D85>\"Transparent\"</color>
        } <color=#57A64A>//Queue Transparent+500 = 3500. Makes sure that it renders
        after everything else in the world.\r</color>\n\r\n        GrabPass {}\r\n\r\n       
        <color=#569CD6>Pass</color>\r\n        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n           
        #pragma <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            #include <color=#D69D85>\"UnityCG.cginc\"</color>\r\n\r\n           
        <color=#569CD6>sampler2D</color> _GrabTexture;\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>appdata</color> {\r\n                <color=#569CD6>float4</color>
        <color=#569CD6>vertex</color> : POSITION;\r\n                <color=#569CD6>float2</color>
        uv : TEXCOORD0;\r\n            };\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>v2f</color> {\r\n                <color=#569CD6>float4</color>
        pos : SV_POSITION;\r\n                <color=#569CD6>float2</color> uv :
        TEXCOORD0;\r\n            };\r\n\r\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n                \r\n                <color=#569CD6>float</color> aspectRatio
        = _ScreenParams.x / _ScreenParams.y;\r\n                v.<color=#569CD6>vertex</color>.x
        *= aspectRatio;\r\n\r\n                o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        o.uv = v.uv;\r\n                return o;\r\n            }\r\n\r\n           
        <color=#569CD6>half4</color> frag (<color=#569CD6>v2f</color> i) : SV_Target
        {\r\n                <color=#569CD6>half3</color> color = tex2D(_GrabTexture,
        i.uv);\r\n                \r\n                return <color=#569CD6>half4</color>(color,
        1.0);\r\n            }\r\n            <color=#569CD6>ENDCG</color>\r\n       
        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
