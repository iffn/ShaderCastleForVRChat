        secondClosestDistance = 8.0;\r\n                <color=#569CD6>float</color>
        closestSeed = 0;\r\n\r\n                [unroll]\r\n                for(int
        w = -1; w <= 1; w++) {\r\n                    for(int z = -1; z <= 1; z++)
        {\r\n                        for(int y = -1; y <= 1; y++) {\r\n                           
        [unroll]\r\n                            for(int x = -1; x <= 1; x++) {\r\n                               
        <color=#569CD6>float4</color> cellOffset = <color=#569CD6>float4</color>(x,
        y, z, w);\r\n                                <color=#569CD6>float4</color>
        cell = baseCell + cellOffset;\r\n                                <color=#569CD6>float</color>
        seed = hash11(hash11(hash11(cell.x) + cell.y) + cell.z) + cell.w;\r\n                               
        \r\n                                <color=#569CD6>float4</color> randomOffset
        = <color=#569CD6>float4</color>(\r\n                                    hash11(seed
