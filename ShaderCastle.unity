      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 3883131558245652288, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/Raymarching/Shapes/RaymarchedRoundedBox-Included\"\r\n{\r\n\tProperties\r\n\t{\r\n\t\t_SideLength
        (\"Side length\", Float) = 0.5\r\n\t\t_Radius (\"Radius\", Float) = 0.1\r\n\t\t_Color
        (\"Sphere Color\", Color) = (1, 0, 0, 1)\r\n\t}\r\n\r\n\tSubShader\r\n\t{\r\n\t\tTags
        { \"RenderType\"=\"Opaque\" \"Queue\"=\"Geometry\" }//\r\n\r\n        Cull
        Front\r\n\r\n\t\tPass\r\n\t\t{\r\n\t\t\tCGPROGRAM\r\n\t\t\t#pragma vertex
        vert\r\n\t\t\t#pragma fragment frag\r\n\t\t\t\r\n\t\t\tfloat _SideLength;\r\n\t\t\tfloat
        _Radius;\r\n\t\t\tfloat4 _Color;\r\n\t\t\t\r\n\t\t\tfloat roundedBoxSDF(float3
        p)\r\n\t\t\t{\r\n\t\t\t\tfloat3 q = abs(p) - _SideLength * 0.5 + _Radius;\r\n\t\t\t\treturn
        length(max(q,0.0)) + min(max(q.x,max(q.y,q.z)),0.0) - _Radius;\r\n\t\t\t}\r\n\r\n\t\t\tfloat
        mainSDF(float3 p)\r\n\t\t\t{\r\n\t\t\t\treturn roundedBoxSDF(p);\r\n\t\t\t}\r\n\r\n\t\t\t#include
        \"Assets/ShaderCastleForVRChat/Tutorials/Raymarching/RaymarchCore.cginc\"\r\n\r\n\t\t\tENDCG\r\n\t\t}\r\n\t}\r\n}\u200B"
      objectReference: {fileID: 0}
    - target: {fileID: 4127777698288987080, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/Raymarching/Shapes/RaymarchedRoundedBox-Included\"</color>\r\n{\r\n\t<color=#569CD6>Properties</color>\r\n\t{\r\n\t\t_SideLength
        (<color=#D69D85>\"Side length\"</color>, Float) = 0.5\r\n\t\t_Radius (<color=#D69D85>\"Radius\"</color>,
        Float) = 0.1\r\n\t\t_Color (<color=#D69D85>\"Sphere Color\"</color>, Color)
        = (1, 0, 0, 1)\r\n\t}\r\n\r\n\t<color=#569CD6>SubShader</color>\r\n\t{\r\n\t\tTags
        { <color=#D69D85>\"RenderType\"</color>=<color=#D69D85>\"Opaque\"</color>
        <color=#D69D85>\"Queue\"</color>=<color=#D69D85>\"Geometry\"</color> }<color=#57A64A>//\r</color>\n\r\n       
        Cull Front\r\n\r\n\t\t<color=#569CD6>Pass</color>\r\n\t\t{\r\n\t\t\t<color=#569CD6>CGPROGRAM</color>\r\n\t\t\t#pragma
        <color=#569CD6>vertex</color> vert\r\n\t\t\t#pragma <color=#569CD6>fragment</color>
        frag\r\n\t\t\t\r\n\t\t\t<color=#569CD6>float</color> _SideLength;\r\n\t\t\t<color=#569CD6>float</color>
        _Radius;\r\n\t\t\t<color=#569CD6>float4</color> _Color;\r\n\t\t\t\r\n\t\t\t<color=#569CD6>float</color>
        roundedBoxSDF(<color=#569CD6>float3</color> p)\r\n\t\t\t{\r\n\t\t\t\t<color=#569CD6>float3</color>
        q = abs(p) - _SideLength * 0.5 + _Radius;\r\n\t\t\t\treturn length(max(q,0.0))
        + min(max(q.x,max(q.y,q.z)),0.0) - _Radius;\r\n\t\t\t}\r\n\r\n\t\t\t<color=#569CD6>float</color>
        mainSDF(<color=#569CD6>float3</color> p)\r\n\t\t\t{\r\n\t\t\t\treturn roundedBoxSDF(p);\r\n\t\t\t}\r\n\r\n\t\t\t#include
        <color=#D69D85>\"Assets/ShaderCastleForVRChat/Tutorials/Raymarching/RaymarchCore.cginc\"</color>\r\n\r\n\t\t\t<color=#569CD6>ENDCG</color>\r\n\t\t}\r\n\t}\r\n}"
      objectReference: {fileID: 0}
