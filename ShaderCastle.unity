    - target: {fileID: 3883131558245652288, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "\u200B"
      objectReference: {fileID: 0}
    - target: {fileID: 4127777698288987080, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Demos/PaintAPlane/PaintAPlane-RenderTexture\"</color>\r\n{\r\n   
        <color=#569CD6>Properties</color>\r\n    {\r\n        _paintMask(<color=#D69D85>\"Paint
        mask\"</color>, 2D) = <color=#D69D85>\"black\"</color> {}\r\n        _paintColor
        (<color=#D69D85>\"Paint color\"</color>, color) = (1.0, 1.0, 1.0, 1.0)\r\n   
        }\r\n\r\n    CGINCLUDE\r\n\r\n    #include <color=#D69D85>\"UnityCustomRenderTexture.cginc\"</color>\r\n   
        \r\n    #define currentTexture(U) tex2D(_SelfTexture2D, U)\r\n\r\n    <color=#569CD6>sampler2D</color>
        _paintMask;\r\n\r\n    <color=#569CD6>float</color> pixelWidthU;\r\n    <color=#569CD6>float</color>
        pixelWidthV;\r\n    <color=#569CD6>float4</color> _paintColor;\r\n    \r\n\r\n   
        <color=#569CD6>float4</color> frag(v2f_customrendertexture i) : SV_Target\r\n   
        {\r\n        <color=#569CD6>float2</color> uv = i.globalTexcoord;\r\n\r\n       
        <color=#569CD6>float4</color> currentColor = currentTexture(uv);\r\n       
        <color=#569CD6>float</color> paintMask = step(0.1, tex2D(_paintMask, uv).r);\r\n\r\n       
        <color=#569CD6>float4</color> color = lerp(currentColor, _paintColor.rgba,
        paintMask);\r\n\r\n        return saturate(color);\r\n    }\r\n\r\n    <color=#569CD6>ENDCG</color>\r\n\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        Cull Off ZWrite Off
        ZTest Always\r\n        <color=#569CD6>Pass</color>\r\n        {\r\n           
        Name <color=#D69D85>\"Update\"</color>\r\n            <color=#569CD6>CGPROGRAM</color>\r\n           
        #pragma <color=#569CD6>vertex</color> CustomRenderTextureVertexShader\r\n           
        #pragma <color=#569CD6>fragment</color> frag\r\n            <color=#569CD6>ENDCG</color>\r\n       
        }\r\n    }\r\n\r\n}"
      objectReference: {fileID: 0}
