    - target: {fileID: 1055789876787810633, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: separateDescriptionCanvas
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1317233556929021119, guid: 7ffcca573e1296d47a9191342db0701b,
