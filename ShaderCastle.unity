--- !u!1001 &4220764757251024030
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 2898358289025906898}
    m_Modifications:
    - target: {fileID: 1415808747208185003, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_Text
      value: "Shader \"ShaderCastle/Tutorials/TextureSampling/TextureAtlasPixels\"\r\n{\r\n   
        Properties\r\n    {\r\n        _MainTex (\"Texture\", 2D) = \"white\" {}\r\n       
        _CellSize (\"Cell Size in Pixels (Width, Height)\", Vector) = (8, 16, 0,
        0)\r\n        _LookupX (\"Lookup coordinate X\", float) = 0\r\n        _LookupY
        (\"Lookup coordinate Y\", float) = 0\r\n    }\r\n    SubShader\r\n    {\r\n       
        Pass\r\n        {\r\n            CGPROGRAM\r\n            #pragma vertex
        vert\r\n            #pragma fragment frag\r\n\r\n            #include \"UnityCG.cginc\"\r\n\r\n           
        sampler2D _MainTex;\r\n            float4 _MainTex_TexelSize; // z = width,
        w = height\r\n            float4 _CellSize;\r\n            float _LookupX;\r\n           
        float _LookupY;\r\n\r\n            struct appdata {\r\n                float4
        vertex : POSITION;\r\n                float2 uv : TEXCOORD0;\r\n           
        };\r\n\r\n            struct v2f {\r\n                float4 pos : SV_POSITION;\r\n               
        float2 uv : TEXCOORD0;\r\n            };\r\n\r\n            v2f vert (appdata
        v) {\r\n                v2f o;\r\n                o.pos = UnityObjectToClipPos(v.vertex);\r\n               
        o.uv = v.uv;\r\n                return o;\r\n            }\r\n\r\n           
        float4 frag (v2f i) : SV_Target {\r\n                float2 lookupCoordinate
        = float2(_LookupX, _LookupY);\r\n\r\n                // _TexelSize: x = 1/xCount,
        y = 1/yCount, z = xCount, w = yCount\r\n                float2 texelSize
        = _MainTex_TexelSize.xy;\r\n\r\n                float2 localPixel = floor(frac(i.uv)
        * _CellSize.xy);\r\n\r\n                float2 pixelOffset = lookupCoordinate
        * _CellSize.xy;\r\n\r\n                float2 finalPixel = pixelOffset +
        localPixel + 0.5;\r\n\r\n                float2 finalUV = finalPixel * texelSize;\r\n\r\n               
        float3 color = tex2D(_MainTex, finalUV).rgb;\r\n                return float4(color,
        1.0);\r\n            }\r\n            ENDCG\r\n        }\r\n    }\r\n}"
      objectReference: {fileID: 0}
    - target: {fileID: 1620021591047607248, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 1620021591047607248, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
    - target: {fileID: 1620021591047607248, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: serializationData.SerializedFormat
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 2611856009585313489, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_MinHeight
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3686973092905522621, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: title
      value: Texture atlas
      objectReference: {fileID: 0}
    - target: {fileID: 3686973092905522621, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: description
      value: 'Texture atlases allow displaying multiple parts of a textures on a
        mesh. They are divided into a grid like pattern and lookup coordinates are
        used to determine what symbol should be used.


        This can also be
        used to construct advanced debug statements.'
      objectReference: {fileID: 0}
