        type: 3}
      propertyPath: m_MinHeight
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3686973092905522621, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: title
      value: Texture display with tiling
      objectReference: {fileID: 0}
    - target: {fileID: 3686973092905522621, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: description
      value: 'When creating a shader, it is often good to think of the overall workflow
        where the final shader is used. Many people don''t know shader programming
        and creating a separate shader for small adjustments doesn''t make much sense.


        A
        very common use case is the tiling of textures wth scale and offset. Unity
        has a built in sampler that integrates well with the UI. This can also be
        shared for multiple texture types like normal maps.'
      objectReference: {fileID: 0}
