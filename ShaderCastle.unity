    - target: {fileID: 8026314177545236412, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/TextureSampling/NormalMap\"</color>\r\n{\r\n   
        <color=#569CD6>Properties</color>\r\n    {\r\n        [Normal] _normalMap
        (<color=#D69D85>\"Normal map\"</color>, 2D) = <color=#D69D85>\"bump\"</color>
        {}\r\n    }\r\n    <color=#569CD6>SubShader</color>\r\n    {\r\n        <color=#569CD6>Pass</color>\r\n       
        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n            #pragma
        <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            #include <color=#D69D85>\"UnityCG.cginc\"</color>\r\n\r\n           
        <color=#569CD6>sampler2D</color> _normalMap;\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>appdata</color> {\r\n                <color=#569CD6>float4</color>
        <color=#569CD6>vertex</color> : POSITION;\r\n                <color=#569CD6>float2</color>
        uv : TEXCOORD0;\r\n            };\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>v2f</color> {\r\n                <color=#569CD6>float4</color>
        pos : SV_POSITION;\r\n                <color=#569CD6>float2</color> uv :
        TEXCOORD0;\r\n            };\r\n\r\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n                o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        o.uv = v.uv;\r\n                return o;\r\n            }\r\n\r\n           
        <color=#569CD6>float4</color> frag (<color=#569CD6>v2f</color> i) : SV_Target
        {\r\n                <color=#569CD6>float4</color> packedNormal = tex2D(_normalMap,
        i.uv);\r\n                <color=#569CD6>float3</color> tangentNormal = UnpackNormal(packedNormal);
        <color=#57A64A>// Unity macro to correctly handle the decompression this
        version of Unity uses\r</color>\n                \r\n                return
        <color=#569CD6>float4</color>(tangentNormal, 1.0);\r\n            }\r\n           
        <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
