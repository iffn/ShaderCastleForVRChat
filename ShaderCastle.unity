        <color=#569CD6>float</color> distanceToCenter = length(uv - <color=#569CD6>float2</color>(0.5,
        0.5));\r\n                <color=#569CD6>float</color> alpha = 1.0 - distanceToCenter
        * 2.0;\r\n\r\n                <color=#569CD6>float3</color> color = <color=#569CD6>float3</color>(1.0,
        1.0, 1.0);\r\n                return <color=#569CD6>float4</color>(color,
        alpha);\r\n            }\r\n            <color=#569CD6>ENDCG</color>\r\n       
