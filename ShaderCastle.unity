    - target: {fileID: 3354350485151747157, guid: bcefd6bd51ce47b438fb5d83f536cd3c,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/Light/SurfaceLight\"\r\n{\r\n    Properties\r\n   
        {\r\n        _emission (\"Emission\", Color) = (0.9, 0.1, 0.1, 1.0)\r\n   
        }\r\n    SubShader\r\n    {\r\n        Pass\r\n        {\r\n            CGPROGRAM\r\n           
        #pragma vertex vert\r\n            #pragma fragment frag\r\n            \r\n           
        half3 _emission;\r\n\r\n            struct appdata {\r\n                float4
        vertex : POSITION;\r\n            };\r\n\r\n            struct v2f {\r\n               
        float4 pos : SV_POSITION;\r\n            };\r\n\r\n            v2f vert (appdata
        v) {\r\n                v2f o;\r\n                o.pos = UnityObjectToClipPos(v.vertex);\r\n               
        return o;\r\n            }\r\n\r\n            half4 frag () : SV_Target {\r\n               
        half3 emissiveLight = _emission;\r\n                half3 reflectedLight
        = half3(0.0, 0.0, 0.0); // No reflective light\r\n\r\n                half3
        surfaceLight = emissiveLight + reflectedLight;\r\n\r\n                return
        half4(surfaceLight, 1.0);\r\n            }\r\n            ENDCG\r\n       
        }\r\n    }\r\n}\r\n\u200B"
      objectReference: {fileID: 0}
    - target: {fileID: 3361782369773763558, guid: bcefd6bd51ce47b438fb5d83f536cd3c,
        type: 3}
      propertyPath: serializedProgramAsset
