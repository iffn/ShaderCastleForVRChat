    - target: {fileID: 3927755816838926537, guid: a093a4876efe3474c90abe853ca06635,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/VertexShader/LocalVertexOffset\"\r\n{\r\n   
        SubShader\r\n    {\r\n        Pass\r\n        {\r\n            CGPROGRAM\r\n           
        #pragma vertex vert\r\n            #pragma fragment frag\r\n            \r\n\r\n           
        struct appdata {\r\n                float4 vertex : POSITION;\r\n           
        };\r\n\r\n            struct v2f {\r\n                float4 pos : SV_POSITION;\r\n           
        };\r\n\r\n            v2f vert (appdata v) {\r\n                v2f o;\r\n               
        v.vertex *= sin(_Time.y) * 0.5 + 0.5; // Modifying the mesh position before
        transforming it\r\n                o.pos = UnityObjectToClipPos(v.vertex);\r\n               
        return o;\r\n            }\r\n\r\n            half4 frag () : SV_Target {\r\n               
        half3 color = half3(1.0, 0.0, 0.0); // Red\r\n                return half4(color,
        1.0);\r\n            }\r\n            ENDCG\r\n        }\r\n    }\r\n}\r\n\u200B"
      objectReference: {fileID: 0}
