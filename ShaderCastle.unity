--- !u!1001 &8486569500218653821
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 2898358289025906898}
    m_Modifications:
    - target: {fileID: 1415808747208185003, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_Text
      value: "Shader \"ShaderCastle/Tutorials/TextureSampling/NormalMap\"\r\n{\r\n   
        Properties\r\n    {\r\n        [Normal] _normalMap (\"Normal map\", 2D) =
        \"bump\" {}\r\n    }\r\n    SubShader\r\n    {\r\n        Pass\r\n       
        {\r\n            CGPROGRAM\r\n            #pragma vertex vert\r\n           
        #pragma fragment frag\r\n            #include \"UnityCG.cginc\"\r\n\r\n           
        sampler2D _normalMap;\r\n\r\n            struct appdata {\r\n               
        float4 vertex : POSITION;\r\n                float2 uv : TEXCOORD0;\r\n           
        };\r\n\r\n            struct v2f {\r\n                float4 pos : SV_POSITION;\r\n               
        float2 uv : TEXCOORD0;\r\n            };\r\n\r\n            v2f vert (appdata
        v) {\r\n                v2f o;\r\n                o.pos = UnityObjectToClipPos(v.vertex);\r\n               
        o.uv = v.uv;\r\n                return o;\r\n            }\r\n\r\n           
        float4 frag (v2f i) : SV_Target {\r\n                float4 packedNormal
        = tex2D(_normalMap, i.uv);\r\n                float3 tangentNormal = UnpackNormal(packedNormal);
        // Unity macro to correctly handle the decompression this version of Unity
        uses\r\n                \r\n                return float4(tangentNormal,
        1.0);\r\n            }\r\n            ENDCG\r\n        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1620021591047607248, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 1620021591047607248, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
    - target: {fileID: 1620021591047607248, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: serializationData.SerializedFormat
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 2611856009585313489, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_MinHeight
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3686973092905522621, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: title
      value: Normal map
      objectReference: {fileID: 0}
    - target: {fileID: 3686973092905522621, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: description
      value: "Normal maps are special textures that store details about the direction
        of the surface, which are usually used in light calculations.\r\n\r\nThere
        are 2 different standards, OpenGL and DirectX. Unity uses OpenGL and then
        converts it to its own optimized system. This changes between versions, which
        is why a built in function is used.\r\n\r\nThe top image displays it as a
        normal albedo image while the bottom one shows it after the conversion.\r\n\r\nFuther
        information can be found in the light section.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 3686973092905522621, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: linkedMaterial
