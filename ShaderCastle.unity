--- !u!1001 &8238998783437834417
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 3716167836180294589}
    m_Modifications:
    - target: {fileID: 676348847684301318, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1415808747208185003, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_Text
      value: "Shader \"ShaderCastle/Tutorials/CustomRenderTexture/GameOfLifeCompute\"\r\n{\r\n   
        Properties\r\n    {\r\n        _originalTexture(\"Original texture\", 2D)
        = \"black\" {}\r\n        _updateStep(\"Update step\", float) = 0.5\r\n   
        }\r\n\r\n    CGINCLUDE\r\n\r\n    #include \"UnityCustomRenderTexture.cginc\"\r\n   
        \r\n    #define currentTexture(U) tex2D(_SelfTexture2D, U)\r\n\r\n    sampler2D
        _paintMask;\r\n    float _updateStep;\r\n\r\n    float4 frag(v2f_customrendertexture
        i) : SV_Target\r\n    {\r\n        float2 uv = i.globalTexcoord;\r\n\r\n       
        float du = 1.0 / _CustomRenderTextureWidth;\r\n        float dv = 1.0 / _CustomRenderTextureHeight;\r\n       
        float4 duv = float4(du, dv, -du ,0);\r\n        \r\n        float4 cell =
        currentTexture(uv); \r\n\r\n        float4 cellUp = currentTexture(uv + duv.wy);\r\n       
        float4 cellDown = currentTexture(uv - duv.wy);\r\n        float4 cellRight
        = currentTexture(uv + duv.xw);\r\n        float4 cellLeft = currentTexture(uv
        - duv.xw);\r\n\r\n        float cellUpRight   = currentTexture(uv + duv.xy);\r\n       
        float cellUpLeft    = currentTexture(uv + duv.zy);\r\n        float cellDownRight
        = currentTexture(uv - duv.zy);\r\n        float cellDownLeft  = currentTexture(uv
        - duv.xy);\r\n\r\n        float neighborsAlive = cellUp + cellDown + cellRight
        + cellLeft + cellUpRight + cellUpLeft + cellDownRight + cellDownLeft;\r\n\r\n       
        float willBeAlive = 0.0;\r\n        if(neighborsAlive == 3.0 || (neighborsAlive
        == 2.0 && cell.r == 1.0))\r\n            willBeAlive = 1.0;\r\n        \r\n       
        float4 deadColor = float4(0,0,0,0);\r\n        float4 aliveColor = float4(1,1,1,1);\r\n       
        \r\n        float4 color = lerp(deadColor, aliveColor, willBeAlive);\r\n\r\n       
        return color;\r\n    }\r\n\r\n    ENDCG\r\n\r\n    SubShader\r\n    {\r\n       
        Cull Off ZWrite Off ZTest Always\r\n        Pass\r\n        {\r\n           
        Name \"Update\"\r\n            CGPROGRAM\r\n            #pragma vertex CustomRenderTextureVertexShader\r\n           
        #pragma fragment frag\r\n            ENDCG\r\n        }\r\n    }\r\n\r\n}"
      objectReference: {fileID: 0}
    - target: {fileID: 1620021591047607248, guid: 3b78f404deb68354e9b08eaf5d093c61,
