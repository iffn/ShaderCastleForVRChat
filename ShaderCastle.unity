    - target: {fileID: 5011955837517992159, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_Text
      value: "Shader \"ShaderCastle/Demos/PaintAPlane/PaintAPlane-RenderTexture\"\r\n{\r\n   
        Properties\r\n    {\r\n        _paintMask(\"Paint mask\", 2D) = \"black\"
        {}\r\n        _paintColor (\"Paint color\", color) = (1.0, 1.0, 1.0, 1.0)\r\n   
        }\r\n\r\n    CGINCLUDE\r\n\r\n    #include \"UnityCustomRenderTexture.cginc\"\r\n   
        \r\n    #define currentTexture(U) tex2D(_SelfTexture2D, U)\r\n\r\n    sampler2D
        _paintMask;\r\n\r\n    float pixelWidthU;\r\n    float pixelWidthV;\r\n   
        float4 _paintColor;\r\n    \r\n\r\n    float4 frag(v2f_customrendertexture
        i) : SV_Target\r\n    {\r\n        float2 uv = i.globalTexcoord;\r\n\r\n       
        float4 currentColor = currentTexture(uv);\r\n        float paintMask = step(0.1,
        tex2D(_paintMask, uv).r);\r\n\r\n        float4 color = lerp(currentColor,
        _paintColor.rgba, paintMask);\r\n\r\n        return saturate(color);\r\n   
        }\r\n\r\n    ENDCG\r\n\r\n    SubShader\r\n    {\r\n        Cull Off ZWrite
        Off ZTest Always\r\n        Pass\r\n        {\r\n            Name \"Update\"\r\n           
        CGPROGRAM\r\n            #pragma vertex CustomRenderTextureVertexShader\r\n           
        #pragma fragment frag\r\n            ENDCG\r\n        }\r\n    }\r\n\r\n}"
      objectReference: {fileID: 0}
