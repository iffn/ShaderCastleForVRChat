    - target: {fileID: 4024073111540509711, guid: fe72e354ba5b33c4889785ac04dfaeb7,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/Raymarching/Shapes/RaymarchedSphere-Included\"</color>\r\n{\r\n\t<color=#569CD6>Properties</color>\r\n\t{\r\n\t\t_SphereRadius
        (<color=#D69D85>\"Sphere Radius\"</color>, Float) = 0.5\r\n\t\t_Color (<color=#D69D85>\"Sphere
        Color\"</color>, Color) = (1, 0, 0, 1)\r\n\t}\r\n\r\n\t<color=#569CD6>SubShader</color>\r\n\t{\r\n\t\tTags
        { <color=#D69D85>\"RenderType\"</color>=<color=#D69D85>\"Opaque\"</color>
        <color=#D69D85>\"Queue\"</color>=<color=#D69D85>\"Geometry\"</color> }<color=#57A64A>//\r</color>\n\r\n       
        Cull Front\r\n\r\n\t\t<color=#569CD6>Pass</color>\r\n\t\t{\r\n\t\t\t<color=#569CD6>CGPROGRAM</color>\r\n\t\t\t#pragma
        <color=#569CD6>vertex</color> vert\r\n\t\t\t#pragma <color=#569CD6>fragment</color>
        frag\r\n\t\t\t\r\n\t\t\t<color=#569CD6>float</color> _SphereRadius;\r\n\t\t\t<color=#569CD6>float4</color>
        _Color;\r\n\t\t\t\r\n\t\t\t<color=#569CD6>float</color> sphereSDF(<color=#569CD6>float3</color>
        p)\r\n\t\t\t{\r\n\t\t\t\treturn length(p) - _SphereRadius;\r\n\t\t\t}\r\n\r\n\t\t\t<color=#569CD6>float</color>
        mainSDF(<color=#569CD6>float3</color> p)\r\n\t\t\t{\r\n\t\t\t\treturn sphereSDF(p);\r\n\t\t\t}\r\n\r\n\t\t\t#include
        <color=#D69D85>\"Assets/ShaderCastleForVRChat/Tutorials/Raymarching/RaymarchCore.cginc\"</color>\r\n\r\n\t\t\t<color=#569CD6>ENDCG</color>\r\n\t\t}\r\n\t}\r\n}"
      objectReference: {fileID: 0}
    - target: {fileID: 4034934934004665742, guid: fe72e354ba5b33c4889785ac04dfaeb7,
