--- !u!1001 &787042743234824038
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 3008070494044054008}
    m_Modifications:
    - target: {fileID: 1415808747208185003, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_Text
      value: "Shader \"ShaderCastle/Tutorials/TextureSampling/MipMapLevel\"\r\n{\r\n   
        Properties\r\n    {\r\n        _MainTex (\"Texture\", 2D) = \"white\" {}\r\n       
        _mipMap (\"MipMap\", float) = 1.0\r\n    }\r\n    SubShader\r\n    {\r\n       
        Pass\r\n        {\r\n            CGPROGRAM\r\n            #pragma vertex
        vert\r\n            #pragma fragment frag\r\n\r\n            sampler2D _MainTex;\r\n           
        float _mipMap;\r\n\r\n            struct appdata {\r\n                float4
        vertex : POSITION;\r\n                float2 uv : TEXCOORD0;\r\n           
        };\r\n\r\n            struct v2f {\r\n                float4 pos : SV_POSITION;\r\n               
        float2 uv : TEXCOORD0;\r\n            };\r\n\r\n            v2f vert (appdata
        v) {\r\n                v2f o;\r\n                o.pos = UnityObjectToClipPos(v.vertex);\r\n               
        o.uv = v.uv;\r\n                return o;\r\n            }\r\n\r\n           
        float4 frag (v2f i) : SV_Target {\r\n                float2 uv = i.uv;\r\n               
        \r\n                float4 textureLookup = float4(uv, 0.0, _mipMap); // 2D
        uvs, unused 3rd dimension, mip map level\r\n                \r\n               
        float3 color = tex2Dlod(_MainTex, textureLookup);\r\n\r\n               
        return float4(color, 1.0);\r\n            }\r\n            ENDCG\r\n       
        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1620021591047607248, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 1620021591047607248, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
    - target: {fileID: 1620021591047607248, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: serializationData.SerializedFormat
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 2611856009585313489, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_MinHeight
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3686973092905522621, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: title
      value: Mip maps
      objectReference: {fileID: 0}
    - target: {fileID: 3686973092905522621, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: description
      value: Just sampling the pixels of textures results in noise, especially when
        scaling it down. Incorporating surrounding pixels makes it better. These
        can be precalculated and stored. Therefore, blurry, low resolution versions
        of the textures are used to make it smoother.
      objectReference: {fileID: 0}
    - target: {fileID: 3686973092905522621, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: linkedMaterial
