    - target: {fileID: 6273522230905759191, guid: e22c1831a6e25ff4999ccd41af9a55c5,
        type: 3}
      propertyPath: m_text
      value: AlphaToMask
      objectReference: {fileID: 0}
    - target: {fileID: 6293581130589200187, guid: e22c1831a6e25ff4999ccd41af9a55c5,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/GrabPass/BasicGrabPass\"\r\n{\r\n   
        SubShader\r\n    {\r\n        Tags { \"Queue\"=\"Transparent+500\" \"RenderType\"=\"Transparent\"
        } //Queue Transparent+500 = 3500. Makes sure that it renders after everything
        else in the world.\r\n\r\n        GrabPass {}\r\n\r\n        Pass\r\n       
        {\r\n            CGPROGRAM\r\n            #pragma vertex vert\r\n           
        #pragma fragment frag\r\n            #include \"UnityCG.cginc\"\r\n\r\n           
        sampler2D _GrabTexture;\r\n\r\n            struct appdata {\r\n               
        float4 vertex : POSITION;\r\n                float2 uv : TEXCOORD0;\r\n           
        };\r\n\r\n            struct v2f {\r\n                float4 pos : SV_POSITION;\r\n               
        float2 uv : TEXCOORD0;\r\n            };\r\n\r\n            v2f vert (appdata
        v) {\r\n                v2f o;\r\n                \r\n                float
        aspectRatio = _ScreenParams.x / _ScreenParams.y;\r\n                v.vertex.x
        *= aspectRatio;\r\n\r\n                o.pos = UnityObjectToClipPos(v.vertex);\r\n               
        o.uv = v.uv;\r\n                return o;\r\n            }\r\n\r\n           
        half4 frag (v2f i) : SV_Target {\r\n                half3 color = tex2D(_GrabTexture,
        i.uv);\r\n                \r\n                return half4(color, 1.0);\r\n           
        }\r\n            ENDCG\r\n        }\r\n    }\r\n}\r\n\u200B"
      objectReference: {fileID: 0}
    - target: {fileID: 6298672440616363156, guid: e22c1831a6e25ff4999ccd41af9a55c5,
        type: 3}
      propertyPath: m_LocalScale.x
      value: 1
