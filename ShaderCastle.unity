    - target: {fileID: 8026314177545236412, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/ProceduralTextures/Checkerboard\"</color>\r\n{\r\n   
        <color=#569CD6>Properties</color>\r\n    {\r\n        _zoom (<color=#D69D85>\"Zoom\"</color>,
        <color=#569CD6>float</color>) = 1\r\n    }\r\n    <color=#569CD6>SubShader</color>\r\n   
        {\r\n        <color=#569CD6>Pass</color>\r\n        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n           
        #pragma <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n\r\n            <color=#569CD6>float</color> _zoom;\r\n\r\n           
        <color=#569CD6>struct</color> <color=#569CD6>appdata</color> {\r\n               
        <color=#569CD6>float4</color> <color=#569CD6>vertex</color> : POSITION;\r\n           
        };\r\n\r\n            <color=#569CD6>struct</color> <color=#569CD6>v2f</color>
        {\r\n                <color=#569CD6>float4</color> pos : SV_POSITION;\r\n               
        <color=#569CD6>float4</color> <color=#569CD6>vertex</color> : TEXCOORD0;\r\n           
        };\r\n\r\n            <color=#569CD6>v2f</color> vert (<color=#569CD6>appdata</color>
        v) {\r\n                <color=#569CD6>v2f</color> o;\r\n               
        o.<color=#569CD6>vertex</color> = v.<color=#569CD6>vertex</color>;\r\n               
        o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        return o;\r\n            }\r\n            \r\n            <color=#569CD6>float</color>
        stepPattern(<color=#569CD6>float</color> x){\r\n                <color=#569CD6>float</color>
        y = frac(x * 0.5);\r\n                y -= 0.5;\r\n                y = sign(y);\r\n               
        y = saturate(y);\r\n                return y;\r\n            }\r\n\r\n           
        <color=#569CD6>float4</color> frag (<color=#569CD6>v2f</color> i) : SV_Target
        {\r\n                <color=#569CD6>float2</color> pos2D = i.<color=#569CD6>vertex</color>.xy;\r\n\r\n               
        pos2D *= _zoom;\r\n\r\n                <color=#569CD6>float3</color> black
        = (0.0, 0.0, 0.0);\r\n                <color=#569CD6>float3</color> white
        = (1.0, 1.0, 1.0);\r\n                \r\n                <color=#569CD6>float</color>
        xStep = stepPattern(pos2D.x);\r\n                <color=#569CD6>float</color>
        yStep = stepPattern(-pos2D.y);\r\n                <color=#569CD6>float</color>
        pattern = abs(xStep - yStep);\r\n\r\n                <color=#569CD6>float3</color>
        color = lerp(black, white, pattern);\r\n\r\n                return <color=#569CD6>float4</color>(color,
        1.0);\r\n            }\r\n            <color=#569CD6>ENDCG</color>\r\n       
        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
