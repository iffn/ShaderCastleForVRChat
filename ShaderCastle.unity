    - target: {fileID: 2460763751909765341, guid: bcefd6bd51ce47b438fb5d83f536cd3c,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/Light/SurfaceLight\"</color>\r\n{\r\n   
        <color=#569CD6>Properties</color>\r\n    {\r\n        _emission (<color=#D69D85>\"Emission\"</color>,
        Color) = (0.9, 0.1, 0.1, 1.0)\r\n    }\r\n    <color=#569CD6>SubShader</color>\r\n   
        {\r\n        <color=#569CD6>Pass</color>\r\n        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n           
        #pragma <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            \r\n            <color=#569CD6>half3</color> _emission;\r\n\r\n           
        <color=#569CD6>struct</color> <color=#569CD6>appdata</color> {\r\n               
        <color=#569CD6>float4</color> <color=#569CD6>vertex</color> : POSITION;\r\n           
        };\r\n\r\n            <color=#569CD6>struct</color> <color=#569CD6>v2f</color>
        {\r\n                <color=#569CD6>float4</color> pos : SV_POSITION;\r\n           
        };\r\n\r\n            <color=#569CD6>v2f</color> vert (<color=#569CD6>appdata</color>
        v) {\r\n                <color=#569CD6>v2f</color> o;\r\n               
        o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        return o;\r\n            }\r\n\r\n            <color=#569CD6>half4</color>
        frag () : SV_Target {\r\n                <color=#569CD6>half3</color> emissiveLight
        = _emission;\r\n                <color=#569CD6>half3</color> reflectedLight
        = <color=#569CD6>half3</color>(0.0, 0.0, 0.0); <color=#57A64A>// No reflective
        light\r</color>\n\r\n                <color=#569CD6>half3</color> surfaceLight
        = emissiveLight + reflectedLight;\r\n\r\n                return <color=#569CD6>half4</color>(surfaceLight,
        1.0);\r\n            }\r\n            <color=#569CD6>ENDCG</color>\r\n       
        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
