PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 899542917018064091}
    m_Modifications:
    - target: {fileID: 646954053806248714, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_LocalPosition.y
      value: 0
