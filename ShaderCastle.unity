    - target: {fileID: 3883131558245652288, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/DepthBuffer/DepthBufferReadScreen\"\r\n{\r\n   
        SubShader\r\n    {\r\n        Pass\r\n        {\r\n            CGPROGRAM\r\n           
        #pragma vertex vert\r\n            #pragma fragment frag\r\n            #include
        \"UnityCG.cginc\"\r\n\r\n            UNITY_DECLARE_DEPTH_TEXTURE(_CameraDepthTexture);\r\n\r\n           
        struct appdata {\r\n                float4 vertex : POSITION;\r\n               
        float2 uv : TEXCOORD0;\r\n            };\r\n\r\n            struct v2f {\r\n               
        float4 pos : SV_POSITION;\r\n                float2 uv : TEXCOORD0;\r\n           
        };\r\n\r\n            v2f vert (appdata v) {\r\n                v2f o;\r\n               
        \r\n                float aspectRatio = _ScreenParams.x / _ScreenParams.y;\r\n               
        v.vertex.x *= aspectRatio;\r\n\r\n                o.pos = UnityObjectToClipPos(v.vertex);\r\n               
        o.uv = v.uv;\r\n                return o;\r\n            }\r\n\r\n           
        half4 frag (v2f i) : SV_Target {\r\n                half3 color = SAMPLE_DEPTH_TEXTURE(_CameraDepthTexture,
        i.uv);\r\n                return half4(color, 1.0);\r\n            }\r\n           
        ENDCG\r\n        }\r\n    }\r\n}\r\n\u200B"
      objectReference: {fileID: 0}
    - target: {fileID: 4127777698288987080, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/DepthBuffer/DepthBufferReadScreen\"</color>\r\n{\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        <color=#569CD6>Pass</color>\r\n       
        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n            #pragma
        <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            #include <color=#D69D85>\"UnityCG.cginc\"</color>\r\n\r\n           
        UNITY_DECLARE_DEPTH_TEXTURE(_CameraDepthTexture);\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>appdata</color> {\r\n                <color=#569CD6>float4</color>
        <color=#569CD6>vertex</color> : POSITION;\r\n                <color=#569CD6>float2</color>
        uv : TEXCOORD0;\r\n            };\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>v2f</color> {\r\n                <color=#569CD6>float4</color>
        pos : SV_POSITION;\r\n                <color=#569CD6>float2</color> uv :
        TEXCOORD0;\r\n            };\r\n\r\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n                \r\n                <color=#569CD6>float</color> aspectRatio
        = _ScreenParams.x / _ScreenParams.y;\r\n                v.<color=#569CD6>vertex</color>.x
        *= aspectRatio;\r\n\r\n                o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        o.uv = v.uv;\r\n                return o;\r\n            }\r\n\r\n           
        <color=#569CD6>float4</color> frag (<color=#569CD6>v2f</color> i) : SV_Target
        {\r\n                <color=#569CD6>float3</color> color = SAMPLE_DEPTH_TEXTURE(_CameraDepthTexture,
        i.uv);\r\n                return <color=#569CD6>float4</color>(color, 1.0);\r\n           
        }\r\n            <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
