    - target: {fileID: 3745400930569506714, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 3745400930569506714, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
    - target: {fileID: 3883131558245652288, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/VertexShader/VertexSpin\"\r\n{\r\n   
        SubShader\r\n    {\r\n        Pass\r\n        {\r\n            CGPROGRAM\r\n           
        #pragma vertex vert\r\n            #pragma fragment frag\r\n            \r\n\r\n           
        struct appdata {\r\n                float4 vertex : POSITION;\r\n           
        };\r\n\r\n            struct v2f {\r\n                float4 pos : SV_POSITION;\r\n           
        };\r\n\r\n            v2f vert (appdata v) {\r\n                v2f o;\r\n\r\n               
        float xOffset = v.vertex.x;\r\n                float zOffset = v.vertex.z;\r\n\r\n               
        float sinTime = sin(_Time.y);\r\n                float cosTime = cos(_Time.y);\r\n\r\n               
        v.vertex.x = xOffset * cosTime + zOffset * sinTime;\r\n                v.vertex.z
        = -xOffset * sinTime + zOffset * cosTime;\r\n                \r\n               
        o.pos = UnityObjectToClipPos(v.vertex);\r\n                return o;\r\n           
        }\r\n\r\n            half4 frag () : SV_Target {\r\n                half3
        color = half3(1.0, 0.0, 0.0);\r\n                return half4(color, 1.0);\r\n           
        }\r\n            ENDCG\r\n        }\r\n    }\r\n}\r\n\u200B"
      objectReference: {fileID: 0}
    - target: {fileID: 4127777698288987080, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/VertexShader/VertexSpin\"</color>\r\n{\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        <color=#569CD6>Pass</color>\r\n       
        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n            #pragma
        <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            \r\n\r\n            <color=#569CD6>struct</color> <color=#569CD6>appdata</color>
        {\r\n                <color=#569CD6>float4</color> <color=#569CD6>vertex</color>
        : POSITION;\r\n            };\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>v2f</color> {\r\n                <color=#569CD6>float4</color>
        pos : SV_POSITION;\r\n            };\r\n\r\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n\r\n                <color=#569CD6>float</color> xOffset = v.<color=#569CD6>vertex</color>.x;\r\n               
        <color=#569CD6>float</color> zOffset = v.<color=#569CD6>vertex</color>.z;\r\n\r\n               
        <color=#569CD6>float</color> sinTime = sin(_Time.y);\r\n                <color=#569CD6>float</color>
        cosTime = cos(_Time.y);\r\n\r\n                v.<color=#569CD6>vertex</color>.x
        = xOffset * cosTime + zOffset * sinTime;\r\n                v.<color=#569CD6>vertex</color>.z
        = -xOffset * sinTime + zOffset * cosTime;\r\n                \r\n               
        o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        return o;\r\n            }\r\n\r\n            <color=#569CD6>float4</color>
        frag () : SV_Target {\r\n                <color=#569CD6>float3</color> color
        = <color=#569CD6>float3</color>(1.0, 0.0, 0.0);\r\n                return
        <color=#569CD6>float4</color>(color, 1.0);\r\n            }\r\n           
        <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}\r\n"
