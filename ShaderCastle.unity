    - target: {fileID: 6827032096239915490, guid: bcefd6bd51ce47b438fb5d83f536cd3c,
        type: 3}
      propertyPath: description
      value: Mip maps store different levels in half their size steps. Over multiple
        levels, this means that the storage size increases by 1/3. The values in
        between are interpolated
      objectReference: {fileID: 0}
    - target: {fileID: 6834493625960570787, guid: bcefd6bd51ce47b438fb5d83f536cd3c,
        type: 3}
