    - target: {fileID: 3745400930569506714, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 3745400930569506714, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
    - target: {fileID: 3883131558245652288, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/VertexShader/Billboard\"\r\n{\r\n   
        SubShader\r\n    {\r\n        Pass\r\n        {\r\n            CGPROGRAM\r\n           
        #pragma vertex vert\r\n            #pragma fragment frag\r\n            \r\n           
        #include \"UnityCG.cginc\"\r\n\r\n            struct appdata {\r\n               
        float4 vertex : POSITION;\r\n            };\r\n\r\n            struct v2f
        {\r\n                float4 pos : SV_POSITION;\r\n            };\r\n\r\n           
        v2f vert (appdata v) {\r\n                v2f o;\r\n\r\n                float4x4
        objectToWorld = unity_ObjectToWorld;\r\n\r\n                float viewScaleX
        = length(float3(objectToWorld._m00, objectToWorld._m10, objectToWorld._m20));\r\n               
        float viewScaleY = length(float3(objectToWorld._m01, objectToWorld._m11,
        objectToWorld._m21));\r\n                \r\n                float4 viewPosition
        = float4(v.vertex.x * viewScaleX, v.vertex.y * viewScaleY, 0, 0);\r\n\r\n               
        float4 viewSpaceCenter = mul(UNITY_MATRIX_MV, float4(0, 0, 0, 1));\r\n               
        float4 viewPos = viewSpaceCenter + viewPosition;\r\n\r\n                o.pos
        = mul(UNITY_MATRIX_P, viewPos);\r\n                \r\n                return
        o;\r\n            }\r\n\r\n            half4 frag () : SV_Target {\r\n               
        half3 color = half3(1.0, 0.0, 0.0); // Red\r\n                return half4(color,
        1.0);\r\n            }\r\n            ENDCG\r\n        }\r\n    }\r\n}\r\n\u200B"
      objectReference: {fileID: 0}
    - target: {fileID: 4127777698288987080, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/VertexShader/Billboard\"</color>\r\n{\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        <color=#569CD6>Pass</color>\r\n       
        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n            #pragma
        <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            \r\n            #include <color=#D69D85>\"UnityCG.cginc\"</color>\r\n\r\n           
        <color=#569CD6>struct</color> <color=#569CD6>appdata</color> {\r\n               
        <color=#569CD6>float4</color> <color=#569CD6>vertex</color> : POSITION;\r\n           
        };\r\n\r\n            <color=#569CD6>struct</color> <color=#569CD6>v2f</color>
        {\r\n                <color=#569CD6>float4</color> pos : SV_POSITION;\r\n           
        };\r\n\r\n            <color=#569CD6>v2f</color> vert (<color=#569CD6>appdata</color>
        v) {\r\n                <color=#569CD6>v2f</color> o;\r\n\r\n               
        float4x4 objectToWorld = unity_ObjectToWorld;\r\n\r\n                <color=#569CD6>float</color>
        viewScaleX = length(<color=#569CD6>float3</color>(objectToWorld._m00, objectToWorld._m10,
        objectToWorld._m20));\r\n                <color=#569CD6>float</color> viewScaleY
        = length(<color=#569CD6>float3</color>(objectToWorld._m01, objectToWorld._m11,
        objectToWorld._m21));\r\n                \r\n                <color=#569CD6>float4</color>
        viewPosition = <color=#569CD6>float4</color>(v.<color=#569CD6>vertex</color>.x
        * viewScaleX, v.<color=#569CD6>vertex</color>.y * viewScaleY, 0, 0);\r\n\r\n               
        <color=#569CD6>float4</color> viewSpaceCenter = mul(UNITY_MATRIX_MV, <color=#569CD6>float4</color>(0,
        0, 0, 1));\r\n                <color=#569CD6>float4</color> viewPos = viewSpaceCenter
        + viewPosition;\r\n\r\n                o.pos = mul(UNITY_MATRIX_P, viewPos);\r\n               
        \r\n                return o;\r\n            }\r\n\r\n            <color=#569CD6>float4</color>
        frag () : SV_Target {\r\n                <color=#569CD6>float3</color> color
        = <color=#569CD6>float3</color>(1.0, 0.0, 0.0); <color=#57A64A>// Red\r</color>\n               
        return <color=#569CD6>float4</color>(color, 1.0);\r\n            }\r\n           
        <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
