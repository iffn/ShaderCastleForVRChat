    - target: {fileID: 3883131558245652288, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/Stencil/StencilBasicWrite\"\r\n{\r\n   
        SubShader\r\n    {\r\n        Tags { \"RenderType\"=\"Opaque\" \"Queue\"=\"Geometry-1\"
        } // Runs before geometry\r\n\r\n        ColorMask 0\r\n        ZWrite Off\r\n\r\n       
        Pass {\r\n            Stencil {\r\n                Ref 1 // What values are
        being written:             xxxx xxx1 (x doesn't matter because of the mask)\r\n               
        WriteMask 1 // Only the last bit should be changed: 0000 0001\r\n               
        Comp Always\r\n                Pass Replace\r\n            }\r\n        }\r\n   
        }\r\n}\u200B"
      objectReference: {fileID: 0}
    - target: {fileID: 3908399993456195078, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_SizeDelta.x
      value: 1.6
      objectReference: {fileID: 0}
    - target: {fileID: 3908399993456195078, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_SizeDelta.y
      value: 0.8
      objectReference: {fileID: 0}
    - target: {fileID: 4127777698288987080, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/Stencil/StencilBasicWrite\"</color>\r\n{\r\n   
        <color=#569CD6>Properties</color>\r\n\t{\r\n\t\t_mask (<color=#D69D85>\"Write
        mask\"</color>, Integer) = 1\r\n\t}\r\n    <color=#569CD6>SubShader</color>\r\n   
        {\r\n        Tags { <color=#D69D85>\"RenderType\"</color>=<color=#D69D85>\"Opaque\"</color>
        <color=#D69D85>\"Queue\"</color>=<color=#D69D85>\"Geometry-1\"</color> }
        <color=#57A64A>// Runs before geometry\r</color>\n\r\n        ColorMask 0\r\n       
        ZWrite Off\r\n\r\n        <color=#569CD6>Pass</color> {\r\n            Stencil
        {\r\n                Ref [_mask] <color=#57A64A>// What values are being
        written,             with 1: xxxx xxx1 (x doesn't matter because of the mask)\r</color>\n               
        WriteMask 255 <color=#57A64A>// Binary mask which pixels should be written.
        With 255: 1111 1111\r</color>\n                Comp Always\r\n               
        <color=#569CD6>Pass</color> Replace\r\n            }\r\n        }\r\n   
        }\r\n}"
      objectReference: {fileID: 0}
