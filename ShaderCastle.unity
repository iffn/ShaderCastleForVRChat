      value: "Shader \"ShaderCastle/Tutorials/Stencil/StencilBasicWrite\"\r\n{\r\n   
        Properties\r\n\t{\r\n\t\t_mask (\"Write mask\", Integer) = 1\r\n\t}\r\n   
        SubShader\r\n    {\r\n        Tags { \"RenderType\"=\"Opaque\" \"Queue\"=\"Geometry-1\"
        } // Runs before geometry\r\n\r\n        ColorMask 0\r\n        ZWrite Off\r\n\r\n       
        Pass {\r\n            Stencil {\r\n                Ref [_mask] // What values
        are being written,             with 1: xxxx xxx1 (x doesn't matter because
        of the mask)\r\n                WriteMask 255 // Binary mask which pixels
        should be written. With 255: 1111 1111\r\n                Comp Always\r\n               
        Pass Replace\r\n            }\r\n        }\r\n    }\r\n}"
