        {\r\n                <color=#569CD6>float4</color> pos : SV_POSITION;\r\n               
        <color=#569CD6>float3</color> worldPos : TEXCOORD0;\r\n                <color=#569CD6>float3</color>
        normal : TEXCOORD1;\r\n                <color=#569CD6>float3</color> worldNormal
        : TEXCOORD2;\r\n                <color=#569CD6>float3</color> worldTangent
        : TEXCOORD3;\r\n                <color=#569CD6>float3</color> worldBitangent
        : TEXCOORD4;\r\n                <color=#569CD6>float2</color> uv : TEXCOORD5;\r\n           
        };\r\n\r\n            <color=#569CD6>v2f</color> vert (<color=#569CD6>appdata</color>
        v) {\r\n                <color=#569CD6>v2f</color> o;\r\n               
        o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        o.worldPos = mul(unity_ObjectToWorld, v.<color=#569CD6>vertex</color>);\r\n               
        o.normal = v.normal;\r\n                o.worldNormal = UnityObjectToWorldNormal(v.normal);\r\n               
