      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1872512769355737056, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1872512769355737056, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2086081743145107749, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "surfaceRadiance\r\n   BRDFLightFactor * surfaceIrradiance\r\n\r\nSurface
        radiance is about how much light the surface reflects back in a certain direction,
        such as at the camera.\r\n\r\nBRDF stands for <i>bidirectional reflectance
        distribution function</i> and describes what happens to the light when it
        hits the surface. Instead of calculating this for every bounce light direction
        with complex surface models, simplified models can be used, which dictate
        the style.\r\n\r\n- For ambient light, it is assumed that light arrives from
        all directions equally.\r\n- The simple diffuse surface model assumes that
        light is reflected in all directions equally."
      objectReference: {fileID: 0}
    - target: {fileID: 2086081743145107749, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_fontSizeBase
      value: 0.03
      objectReference: {fileID: 0}
    - target: {fileID: 2453436135830993782, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2453436135830993782, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2676220887514110487, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2735085066506440042, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3323022602836515612, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 3323022602836515612, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
    - target: {fileID: 3472797892674940223, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
