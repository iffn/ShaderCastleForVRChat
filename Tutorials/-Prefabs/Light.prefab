    - target: {fileID: 2086081743145107749, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: 'When light hits a material, part of it gets reflected. How much depends
        on the incoming light angle and material.

        The rest eiter enters
        the material or gets absorbed. For metallic material everything gets absorbed.

        For
        non-metallic materials, the light that enters the material can pass through
        it or get reflected inside. If this happens a lot, the material is diffuse,
        if not, it is transparent.



        If the surface is rough, the light
        is reflected in different ways. These Microfacets aren''t modelled but instead
        described statistically with a roughness term.



        The Cook-Torrance
        Microfacet BRDF function describes the behavior of non-transparent materials
        by giving it a metallic and a smoothness/roughness value in the range of
        0 to 1.



        While it only makes sense to have a metallic value of
        0 or 1, having a blend between them makes sense for pixels where there is
        a mix of both types.'
      objectReference: {fileID: 0}
    - target: {fileID: 2086081743145107749, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_fontSizeBase
      value: 0.03
      objectReference: {fileID: 0}
    - target: {fileID: 2453436135830993782, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2453436135830993782, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3323022602836515612, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 3323022602836515612, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
    - target: {fileID: 3472797892674940223, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3472797892674940223, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3472797892674940223, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3883131558245652288, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/Light/PhongSpecular\"\r\n{\r\n    Properties\r\n   
        {\r\n        _world_light_direction (\"World light direciton\", Vector) =
        (1,1,1,0)\r\n        _light_color (\"Light color\", color) = (1,1,1,1)\r\n       
        _ambient_light_color (\"Ambient light color\", color) = (1,1,1,1)\r\n       
        _albedo (\"Albedo\", color) = (1,1,1,1)\r\n        _smoothness (\"Smoothness\",
        Range(0, 1)) = 0.5\r\n    }\r\n    SubShader\r\n    {\r\n        \r\n       
        Pass\r\n        {\r\n            CGPROGRAM\r\n            #pragma vertex
        vert\r\n            #pragma fragment frag\r\n            #include \"UnityCG.cginc\"\r\n\r\n           
        float3 _world_light_direction;\r\n            half4 _light_color;\r\n           
        half4 _ambient_light_color;\r\n            half4 _albedo;\r\n           
        float _smoothness;\r\n\r\n            struct appdata {\r\n               
        float4 vertex : POSITION;\r\n                float3 normal : NORMAL;\r\n           
        };\r\n\r\n            struct v2f {\r\n                float4 pos : SV_POSITION;\r\n               
        float3 worldPos : TEXCOORD0;\r\n                float3 worldNormal : TEXCOORD1;\r\n           
        };\r\n\r\n            v2f vert (appdata v) {\r\n                v2f o;\r\n               
        o.pos = UnityObjectToClipPos(v.vertex);\r\n                o.worldPos = mul(unity_ObjectToWorld,
        v.vertex);\r\n                o.worldNormal = UnityObjectToWorldNormal(v.normal);\r\n               
        o.worldNormal = normalize(o.worldNormal);\r\n\r\n                return o;\r\n           
        }\r\n\r\n            half4 frag (v2f i) : SV_Target {\r\n               
        float3 worldNormal = normalize(i.worldNormal);\r\n                float3
        normalized_world_light_direction = normalize(_world_light_direction);\r\n               
        \r\n                half3 ambientLight = _albedo * _ambient_light_color;\r\n\r\n               
        half3 diffuse = dot(normalized_world_light_direction, worldNormal);\r\n               
        diffuse *= _albedo;\r\n                diffuse *= _light_color.rgb;\r\n               
        diffuse = saturate(diffuse);\r\n\r\n                float3 viewDir = normalize(_WorldSpaceCameraPos
        - i.worldPos);\r\n                float3 reflectionDir = reflect(-normalized_world_light_direction,
        worldNormal);\r\n                float specular = dot(viewDir, reflectionDir);\r\n               
        specular = saturate(specular);\r\n                specular = pow(specular,
        _smoothness * 100);\r\n                float specularColor = _light_color
        * specular;\r\n                \r\n                half3 color = half3(diffuse
        + specularColor + ambientLight);\r\n                return half4(color, 1.0);\r\n           
        }\r\n            ENDCG\r\n        }\r\n    }\r\n}\u200B"
      objectReference: {fileID: 0}
    - target: {fileID: 4127777698288987080, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/Light/PhongSpecular\"</color>\r\n{\r\n   
        <color=#569CD6>Properties</color>\r\n    {\r\n        _world_light_direction
        (<color=#D69D85>\"World light direciton\"</color>, Vector) = (1,1,1,0)\r\n       
        _light_color (<color=#D69D85>\"Light color\"</color>, color) = (1,1,1,1)\r\n       
        _ambient_light_color (<color=#D69D85>\"Ambient light color\"</color>, color)
        = (1,1,1,1)\r\n        _albedo (<color=#D69D85>\"Albedo\"</color>, color)
        = (1,1,1,1)\r\n        _smoothness (<color=#D69D85>\"Smoothness\"</color>,
        Range(0, 1)) = 0.5\r\n    }\r\n    <color=#569CD6>SubShader</color>\r\n   
        {\r\n        \r\n        <color=#569CD6>Pass</color>\r\n        {\r\n           
        <color=#569CD6>CGPROGRAM</color>\r\n            #pragma <color=#569CD6>vertex</color>
        vert\r\n            #pragma <color=#569CD6>fragment</color> frag\r\n           
        #include <color=#D69D85>\"UnityCG.cginc\"</color>\r\n\r\n            <color=#569CD6>float3</color>
        _world_light_direction;\r\n            <color=#569CD6>half4</color> _light_color;\r\n           
        <color=#569CD6>half4</color> _ambient_light_color;\r\n            <color=#569CD6>half4</color>
        _albedo;\r\n            <color=#569CD6>float</color> _smoothness;\r\n\r\n           
        <color=#569CD6>struct</color> <color=#569CD6>appdata</color> {\r\n               
        <color=#569CD6>float4</color> <color=#569CD6>vertex</color> : POSITION;\r\n               
        <color=#569CD6>float3</color> normal : NORMAL;\r\n            };\r\n\r\n           
        <color=#569CD6>struct</color> <color=#569CD6>v2f</color> {\r\n               
        <color=#569CD6>float4</color> pos : SV_POSITION;\r\n                <color=#569CD6>float3</color>
        worldPos : TEXCOORD0;\r\n                <color=#569CD6>float3</color> worldNormal
        : TEXCOORD1;\r\n            };\r\n\r\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n                o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        o.worldPos = mul(unity_ObjectToWorld, v.<color=#569CD6>vertex</color>);\r\n               
        o.worldNormal = UnityObjectToWorldNormal(v.normal);\r\n                o.worldNormal
        = normalize(o.worldNormal);\r\n\r\n                return o;\r\n           
        }\r\n\r\n            <color=#569CD6>half4</color> frag (<color=#569CD6>v2f</color>
        i) : SV_Target {\r\n                <color=#569CD6>float3</color> worldNormal
        = normalize(i.worldNormal);\r\n                <color=#569CD6>float3</color>
        normalized_world_light_direction = normalize(_world_light_direction);\r\n               
        \r\n                <color=#569CD6>half3</color> ambientLight = _albedo *
        _ambient_light_color;\r\n\r\n                <color=#569CD6>half3</color>
        diffuse = dot(normalized_world_light_direction, worldNormal);\r\n               
        diffuse *= _albedo;\r\n                diffuse *= _light_color.rgb;\r\n               
        diffuse = saturate(diffuse);\r\n\r\n                <color=#569CD6>float3</color>
        viewDir = normalize(_WorldSpaceCameraPos - i.worldPos);\r\n               
        <color=#569CD6>float3</color> reflectionDir = reflect(-normalized_world_light_direction,
        worldNormal);\r\n                <color=#569CD6>float</color> specular =
        dot(viewDir, reflectionDir);\r\n                specular = saturate(specular);\r\n               
        specular = pow(specular, _smoothness * 100);\r\n                <color=#569CD6>float</color>
        specularColor = _light_color * specular;\r\n                \r\n               
        <color=#569CD6>half3</color> color = <color=#569CD6>half3</color>(diffuse
        + specularColor + ambientLight);\r\n                return <color=#569CD6>half4</color>(color,
        1.0);\r\n            }\r\n            <color=#569CD6>ENDCG</color>\r\n       
        }\r\n    }\r\n}"
