    - target: {fileID: 3883131558245652288, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/Light/UnityDirectionalLight\"\r\n{\r\n   
        SubShader\r\n    {\r\n        Pass\r\n        {\r\n            CGPROGRAM\r\n           
        #pragma vertex vert\r\n            #pragma fragment frag\r\n            #include
        \"UnityCG.cginc\"\r\n            #include \"Lighting.cginc\"\r\n\r\n           
        struct appdata {\r\n                float4 vertex : POSITION;\r\n               
        float3 normal : NORMAL;\r\n            };\r\n\r\n            struct v2f {\r\n               
        float4 pos : SV_POSITION;\r\n                float3 worldNormal : TEXCOORD0;\r\n           
        };\r\n\r\n            v2f vert (appdata v) {\r\n                v2f o;\r\n               
        o.pos = UnityObjectToClipPos(v.vertex);\r\n                o.worldNormal
        = UnityObjectToWorldNormal(v.normal);\r\n\r\n                return o;\r\n           
        }\r\n\r\n            half4 frag (v2f i) : SV_Target {\r\n               
        float3 worldNormal = normalize(i.worldNormal);\r\n                float3
        _world_light_direction = normalize(_WorldSpaceLightPos0.xyz);\r\n               
        float3 lightColor = _LightColor0.rgb;\r\n\r\n                half3 NdotL
        = dot(worldNormal, _world_light_direction);\r\n                NdotL = saturate(NdotL);\r\n               
        \r\n                half3 diffuse = NdotL * lightColor;\r\n               
        \r\n                return half4(diffuse, 1.0);\r\n            }\r\n           
        ENDCG\r\n        }\r\n    }\r\n}\u200B"
      objectReference: {fileID: 0}
    - target: {fileID: 4127777698288987080, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/Light/UnityDirectionalLight\"</color>\r\n{\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        <color=#569CD6>Pass</color>\r\n       
        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n            #pragma
        <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            #include <color=#D69D85>\"UnityCG.cginc\"</color>\r\n           
        #include <color=#D69D85>\"Lighting.cginc\"</color>\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>appdata</color> {\r\n                <color=#569CD6>float4</color>
        <color=#569CD6>vertex</color> : POSITION;\r\n                <color=#569CD6>float3</color>
        normal : NORMAL;\r\n            };\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>v2f</color> {\r\n                <color=#569CD6>float4</color>
        pos : SV_POSITION;\r\n                <color=#569CD6>float3</color> worldNormal
        : TEXCOORD0;\r\n            };\r\n\r\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n                o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        o.worldNormal = UnityObjectToWorldNormal(v.normal);\r\n\r\n               
        return o;\r\n            }\r\n\r\n            <color=#569CD6>half4</color>
        frag (<color=#569CD6>v2f</color> i) : SV_Target {\r\n                <color=#569CD6>float3</color>
        worldNormal = normalize(i.worldNormal);\r\n                <color=#569CD6>float3</color>
        _world_light_direction = normalize(_WorldSpaceLightPos0.xyz);\r\n               
        <color=#569CD6>float3</color> lightColor = _LightColor0.rgb;\r\n\r\n               
        <color=#569CD6>half3</color> NdotL = dot(worldNormal, _world_light_direction);\r\n               
        NdotL = saturate(NdotL);\r\n                \r\n                <color=#569CD6>half3</color>
        diffuse = NdotL * lightColor;\r\n                \r\n                return
        <color=#569CD6>half4</color>(diffuse, 1.0);\r\n            }\r\n           
        <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}"
      objectReference: {fileID: 0}
