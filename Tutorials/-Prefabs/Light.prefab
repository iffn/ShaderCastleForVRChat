    - target: {fileID: 5011955837517992159, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_Text
      value: "Shader \"ShaderCastle/Tutorials/Light/SurfaceLight\"\r\n{\r\n    SubShader\r\n   
        {\r\n        Pass\r\n        {\r\n            CGPROGRAM\r\n            #pragma
        vertex vert\r\n            #pragma fragment frag\r\n\r\n            struct
        appdata {\r\n                float4 vertex : POSITION;\r\n            };\r\n\r\n           
        struct v2f {\r\n                float4 pos : SV_POSITION;\r\n           
        };\r\n\r\n            v2f vert (appdata v) {\r\n                v2f o;\r\n               
        o.pos = UnityObjectToClipPos(v.vertex);\r\n                return o;\r\n           
        }\r\n\r\n            half4 frag () : SV_Target {\r\n                half3
        emissiveLight = half3(1.0, 0.0, 0.0);\r\n                half3 reflectedLight
        = half3(0.0, 0.0, 0.0);\r\n\r\n                half3 emittedLight = emissiveLight
        + reflectedLight;\r\n\r\n                return half4(emittedLight, 1.0);\r\n           
        }\r\n            ENDCG\r\n        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
