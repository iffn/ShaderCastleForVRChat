    - target: {fileID: 1872512769355737056, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1872512769355737056, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1872512769355737056, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2086081743145107749, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "surfaceIrradiance = \r\n   radiantIntensity\r\n   * dot(normal, lightVector)\r\n\r\nThe
        irradiance is the light that actually hits the surface and is relative to
        the angle between the light and the surface normal.\n\nFor the calculation,
        it is easiest to use vectors that point away from the surface. The lightVector
        therefore points towards the light source.\n\nThe dot product of normalized
        vectors is equal to the cosine of the angle of the normal and the light vector.
        So 1 if they align and 0 at 90\xB0"
      objectReference: {fileID: 0}
    - target: {fileID: 2453436135830993782, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2453436135830993782, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2676220887514110487, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3323022602836515612, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 3323022602836515612, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
    - target: {fileID: 3472797892674940223, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3472797892674940223, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3472797892674940223, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3883131558245652288, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/Light/LambertLightDirection\"\r\n{\r\n   
        Properties\r\n    {\r\n        _world_light_direction (\"World light direciton\",
        Vector) = (1,1,1,0)\r\n    }\r\n    SubShader\r\n    {\r\n        \r\n       
        Pass\r\n        {\r\n            CGPROGRAM\r\n            #pragma vertex
        vert\r\n            #pragma fragment frag\r\n            #include \"UnityCG.cginc\"\r\n\r\n           
        float3 _world_light_direction;\r\n\r\n            struct appdata {\r\n               
        float4 vertex : POSITION;\r\n                float3 normal : NORMAL;\r\n           
        };\r\n\r\n            struct v2f {\r\n                float4 pos : SV_POSITION;\r\n               
        float3 worldNormal : TEXCOORD0;\r\n            };\r\n\r\n            v2f
        vert (appdata v) {\r\n                v2f o;\r\n                o.pos = UnityObjectToClipPos(v.vertex);\r\n               
        o.worldNormal = UnityObjectToWorldNormal(v.normal);\r\n                o.worldNormal
        = normalize(o.worldNormal);\r\n\r\n                return o;\r\n           
        }\r\n\r\n            half4 frag (v2f i) : SV_Target {\r\n               
        float3 worldNormal = normalize(i.worldNormal);\r\n                float3
        normalized_world_light_direction = normalize(_world_light_direction);\r\n\r\n               
        half3 NdotL = dot(worldNormal, normalized_world_light_direction);\r\n               
        \r\n                return half4(NdotL, 1.0);\r\n            }\r\n           
        ENDCG\r\n        }\r\n    }\r\n}\u200B"
      objectReference: {fileID: 0}
    - target: {fileID: 4007255147528135500, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4007255147528135500, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4127777698288987080, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/Light/LambertLightDirection\"</color>\r\n{\r\n   
        <color=#569CD6>Properties</color>\r\n    {\r\n        _worldLightDirection
        (<color=#D69D85>\"World light direciton\"</color>, Vector) = (1,1,1,0)\r\n       
        _directionalLightColor (<color=#D69D85>\"Light color\"</color>, Color) =
        (1,1,1,1)\r\n        _albedo (<color=#D69D85>\"Albedo\"</color>, Color) =
        (1,1,1,1)\r\n    }\r\n    <color=#569CD6>SubShader</color>\r\n    {\r\n       
        \r\n        <color=#569CD6>Pass</color>\r\n        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n           
        #pragma <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            #include <color=#D69D85>\"UnityCG.cginc\"</color>\r\n\r\n           
        <color=#569CD6>float3</color> _worldLightDirection;\r\n            <color=#569CD6>half3</color>
        _directionalLightColor;\r\n            <color=#569CD6>half3</color> _albedo;\r\n\r\n           
        <color=#569CD6>struct</color> <color=#569CD6>appdata</color> {\r\n               
        <color=#569CD6>float4</color> <color=#569CD6>vertex</color> : POSITION;\r\n               
        <color=#569CD6>float3</color> normal : NORMAL;\r\n            };\r\n\r\n           
        <color=#569CD6>struct</color> <color=#569CD6>v2f</color> {\r\n               
        <color=#569CD6>float4</color> pos : SV_POSITION;\r\n                <color=#569CD6>float3</color>
        worldNormal : TEXCOORD0;\r\n            };\r\n\r\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n                o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        o.worldNormal = UnityObjectToWorldNormal(v.normal);\r\n                o.worldNormal
        = normalize(o.worldNormal);\r\n\r\n                return o;\r\n           
        }\r\n\r\n            <color=#569CD6>half4</color> frag (<color=#569CD6>v2f</color>
        i) : SV_Target {\r\n                <color=#57A64A>// All vectors are normalized
        and point away from the surface\r</color>\n                <color=#569CD6>float3</color>
        worldNormal = normalize(i.worldNormal);\r\n                <color=#569CD6>float3</color>
        lightVector = -normalize(_worldLightDirection);\r\n\r\n                <color=#569CD6>half3</color>
        emissiveLight = <color=#569CD6>half3</color>(0.0, 0.0, 0.0);\r\n\r\n               
        <color=#57A64A>// Light hitting the surface:\r</color>\n                <color=#569CD6>half</color>
        NdotL = saturate(dot(worldNormal, lightVector));\r\n                <color=#569CD6>half3</color>
        radiantIntensity = _directionalLightColor;\r\n                <color=#569CD6>half3</color>
        surfaceIrradiance = radiantIntensity * NdotL;\r\n                \r\n               
        <color=#57A64A>// How much is reflected:\r</color>\n                <color=#569CD6>half3</color>
        BRDFLightFactor = _albedo; <color=#57A64A>// Simplified model: The light
        gets refelcted in all directions equally.\r</color>\n                <color=#569CD6>half3</color>
        surfaceRadiance = BRDFLightFactor * surfaceIrradiance;\r\n\r\n               
        <color=#569CD6>half3</color> emittedLight = emissiveLight + surfaceRadiance;\r\n\r\n               
        return <color=#569CD6>half4</color>(emittedLight, 1.0);\r\n            }\r\n           
        <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}"
      objectReference: {fileID: 0}
