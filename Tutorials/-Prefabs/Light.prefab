      value: "Shader \"ShaderCastle/Tutorials/Light/Metallic\"\r\n{\r\n    Properties\r\n   
        {\r\n        _world_light_direction (\"World light direciton\", Vector) =
        (1,1,1,0)\r\n        _light_color (\"Light color\", color) = (1,1,1,1)\r\n       
        _ambient_light_color (\"Ambient light color\", color) = (1,1,1,1)\r\n       
