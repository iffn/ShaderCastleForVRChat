    - target: {fileID: 2086081743145107749, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "SurfaceLight = \r\n\tEmissiveLight + ReflectiveLight\r\n\r\nIn the
        physical world, surfaces can only be seen when they interact with light.
        They can either emit light themselves or reflect light from a different source.\r\nThe
        total light at the surface is the sum of these two.\r\n\r\nWhen just outputting
        the value red, the surface is essentially emitting red light while not interacting
        with the environment light at all."
      objectReference: {fileID: 0}
    - target: {fileID: 2086081743145107749, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_fontSizeBase
      value: 0.03
      objectReference: {fileID: 0}
    - target: {fileID: 2453436135830993782, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2453436135830993782, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2676220887514110487, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2735085066506440042, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3323022602836515612, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 3323022602836515612, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
    - target: {fileID: 3472797892674940223, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3472797892674940223, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3472797892674940223, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3883131558245652288, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/Basics/JustRed\"\r\n{\r\n    SubShader\r\n   
        {\r\n        Pass\r\n        {\r\n            CGPROGRAM\r\n            #pragma
        vertex vert // The vertex function is called vert\r\n            #pragma
        fragment frag // The fragment funciton is called frag\r\n\r\n           
        // Mesh to vertex transfer data\r\n            struct appdata {\r\n               
        float4 vertex : POSITION;\r\n            };\r\n\r\n            // Vertex
        to fragment transfer data\r\n            struct v2f {\r\n               
        float4 pos : SV_POSITION;\r\n            };\r\n\r\n            // Vertex
        function\r\n            v2f vert (appdata v) {\r\n                v2f o;\r\n               
        o.pos = UnityObjectToClipPos(v.vertex); // Basic object to clip space transformation\r\n               
        return o;\r\n            }\r\n\r\n            // Fragment function\r\n           
        half4 frag () : SV_Target {\r\n                half3 color = half3(1.0, 0.0,
        0.0); // Red\r\n                return half4(color, 1.0); // 1.0 on alpha
        channel, default for opaque\r\n            }\r\n            ENDCG\r\n       
        }\r\n    }\r\n}\r\n\u200B"
      objectReference: {fileID: 0}
    - target: {fileID: 4007255147528135500, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4007255147528135500, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4127777698288987080, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/Light/SurfaceLight\"</color>\r\n{\r\n   
        <color=#569CD6>SubShader</color>\r\n    {\r\n        <color=#569CD6>Pass</color>\r\n       
        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n            #pragma
        <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n\r\n            <color=#569CD6>struct</color> <color=#569CD6>appdata</color>
        {\r\n                <color=#569CD6>float4</color> <color=#569CD6>vertex</color>
        : POSITION;\r\n            };\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>v2f</color> {\r\n                <color=#569CD6>float4</color>
        pos : SV_POSITION;\r\n            };\r\n\r\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n                o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        return o;\r\n            }\r\n\r\n            <color=#569CD6>half4</color>
        frag () : SV_Target {\r\n                <color=#569CD6>half3</color> emissiveLight
        = <color=#569CD6>half3</color>(1.0, 0.0, 0.0);\r\n                <color=#569CD6>half3</color>
        reflectedLight = <color=#569CD6>half3</color>(0.0, 0.0, 0.0);\r\n\r\n               
        <color=#569CD6>half3</color> emittedLight = emissiveLight + reflectedLight;\r\n\r\n               
        return <color=#569CD6>half4</color>(emittedLight, 1.0);\r\n            }\r\n           
        <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}\r\n"
