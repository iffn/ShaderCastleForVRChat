        i.worldPos);\r\n\r\n                <color=#569CD6>half4</color> color =
        tex2D(_albedo, i.uv);\r\n\r\n                <color=#569CD6>float3</color>
        specularTint = color * _metallic;\r\n\t\t\t\t<color=#569CD6>float</color>
        oneMinusReflectivity;\r\n                <color=#569CD6>float3</color> albedo
        = DiffuseAndSpecularFromMetallic(color.rgb, _metallic, specularTint, oneMinusReflectivity);\r\n\r\n               
        UnityLight light;\r\n                light.color = _light_color;\r\n               
        light.dir = _world_light_direction;\r\n                light.ndotl = saturate(dot(worldNormal,
        normalized_world_light_direction));\r\n\r\n                <color=#569CD6>float3</color>
        reflectDir = reflect(-viewDir, worldNormal);\r\n                <color=#569CD6>float</color>
        perceptualRoughness = 1.0 - _smoothness;\r\n                <color=#569CD6>float</color>
        mip = perceptualRoughness * UNITY_SPECCUBE_LOD_STEPS;\r\n               
