    - target: {fileID: 8512707219535177964, guid: fe72e354ba5b33c4889785ac04dfaeb7,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/ProceduralTextures/Voronoi2D\"</color>\r\n{\r\n   
        <color=#569CD6>Properties</color>\r\n    {\r\n        _zoom (<color=#D69D85>\"Zoom\"</color>,
        <color=#569CD6>float</color>) = 1\r\n    }\r\n    <color=#569CD6>SubShader</color>\r\n   
        {\r\n        <color=#569CD6>Pass</color>\r\n        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n           
        #pragma <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            #pragma target 3.5\r\n\r\n            <color=#569CD6>float</color>
        _zoom;\r\n\r\n            <color=#569CD6>struct</color> <color=#569CD6>appdata</color>
        {\r\n                <color=#569CD6>float4</color> <color=#569CD6>vertex</color>
        : POSITION;\r\n            };\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>v2f</color> {\r\n                <color=#569CD6>float4</color>
        pos : SV_POSITION;\r\n                <color=#569CD6>float4</color> <color=#569CD6>vertex</color>
        : TEXCOORD0;\r\n            };\r\n\r\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n                o.<color=#569CD6>vertex</color> = v.<color=#569CD6>vertex</color>;\r\n               
        o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        return o;\r\n            }\r\n\r\n            <color=#569CD6>float</color>
        hash11(<color=#569CD6>float</color> p) {\r\n                uint h = asuint(p);\r\n\r\n               
        h ^= 0x27D4EB2DU; \r\n\r\n                h = h * 1103515245U + 12345U;\r\n               
        h ^= (h >> 16);\r\n                h *= 0x85ebca6bU;\r\n                h
        ^= (h >> 13);\r\n                h *= 0xc2b2ae35U;\r\n                h ^=
        (h >> 16);\r\n\r\n                return <color=#569CD6>float</color>(h &
        0x00ffffffu) / <color=#569CD6>float</color>(0x01000000u);\r\n           
        }\r\n\r\n            <color=#569CD6>float3</color> voronoi2D(<color=#569CD6>float2</color>
        position) {\r\n                <color=#569CD6>float2</color> baseCell = floor(position);\r\n\r\n               
        <color=#569CD6>float</color> closestDistance = 8.0;\r\n                <color=#569CD6>float</color>
        secondClosestDistance = 8.0;\r\n                <color=#569CD6>float</color>
        closestSeed = 0;\r\n\r\n                [unroll]\r\n                for(int
        y = -1; y <= 1; y++) {\r\n                    [unroll]\r\n                   
        for(int x = -1; x <= 1; x++) {\r\n                        <color=#569CD6>float2</color>
        cellOffset = <color=#569CD6>float2</color>(x, y);\r\n                       
        <color=#569CD6>float2</color> cell = baseCell + cellOffset;\r\n                       
        <color=#569CD6>float</color> seed = hash11(cell.x) + cell.y;\r\n                       
        \r\n                        <color=#569CD6>float2</color> randomOffset =
        <color=#569CD6>float2</color>(\r\n                            hash11(seed
        + 111.111),\r\n                            hash11(seed + 222.222)\r\n                       
        );\r\n\r\n                        <color=#569CD6>float2</color> cellPosition
        = cell + randomOffset;\r\n                        <color=#569CD6>float2</color>
        distanceToCell = cellPosition - position;\r\n                        <color=#569CD6>float</color>
        distance = length(distanceToCell);\r\n\r\n                        if(distance
        < closestDistance) {\r\n                            secondClosestDistance
        = closestDistance;\r\n                            closestDistance = distance;\r\n                           
        closestSeed = seed;\r\n                        } else if (distance < secondClosestDistance)
        {\r\n                            secondClosestDistance = distance;\r\n                       
        }\r\n                    }\r\n                }\r\n\r\n                <color=#569CD6>float</color>
        edgeDist = secondClosestDistance - closestDistance;\r\n                \r\n               
        <color=#569CD6>float</color> cellID = hash11(closestSeed);\r\n\r\n               
        return <color=#569CD6>float3</color>(closestDistance, cellID, edgeDist);\r\n           
        }\r\n            \r\n            <color=#569CD6>half4</color> frag (<color=#569CD6>v2f</color>
        i) : SV_Target {\r\n                <color=#569CD6>float2</color> pos2D =
        i.<color=#569CD6>vertex</color>.xy;\r\n                pos2D *= _zoom;\r\n\r\n               
        <color=#569CD6>half3</color> color = voronoi2D(pos2D);\r\n               
        return <color=#569CD6>half4</color>(color.rgb, 1.0);\r\n            }\r\n\r\n           
        <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
