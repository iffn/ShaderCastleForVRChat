      value: 
      objectReference: {fileID: 2100000, guid: f6780d0c13f02d242a3b66059a16c7ca, type: 2}
    - target: {fileID: 668238383703315284, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_Material
      value: 
      objectReference: {fileID: 2100000, guid: 35630e38b4e5ffb40b44ec5348b4333f, type: 2}
    - target: {fileID: 716293050173795995, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 716293050173795995, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 716293050173795995, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2086081743145107749, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: 'Modeling tiny surface details and displaying them as a mesh would be
        extremely costly. Therefore, normal maps are used, which represent the offset
        between the model surface and the surface that should be displayed. This
        can then be used in the light calculation.



        Normal maps are in
        tangent space, which means they are projected on a tangential plane that
        touches the surface at the sampling point. The color channels are remapped
        from 0...1 to -1...1.  Red represents the tangent direction, green the bitangent
        direction and blue the normal direction. OpenGL (and Unity) uses a right
        while DirectX uses a left handed coordinate system standard, which means
        the bitangent is sometimes inverted.



        Since they are normalized,
        only 2 channels are actually needed. Therefore, Unity uses an internal packing
        and unpacking method. To convert the normal maps to world space, the TBN
        (Tangent, Bitangent, Normal) Matrix is used.

'
      objectReference: {fileID: 0}
    - target: {fileID: 2094626453843948672, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_LocalScale.x
      value: 0.3
      objectReference: {fileID: 0}
    - target: {fileID: 2094626453843948672, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_LocalScale.y
      value: 0.3
      objectReference: {fileID: 0}
    - target: {fileID: 2094626453843948672, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_LocalScale.z
      value: 0.3
      objectReference: {fileID: 0}
    - target: {fileID: 2453436135830993782, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2453436135830993782, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_AnchorMin.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3323022602836515612, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 3323022602836515612, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
    - target: {fileID: 3883131558245652288, guid: 7ffcca573e1296d47a9191342db0701b,
        type: 3}
      propertyPath: m_text
      value: "Shader \"ShaderCastle/Tutorials/Light/AmbientLight\"\r\n{\r\n    Properties\r\n   
        {\r\n        _world_light_direction (\"World light direciton\", Vector) =
        (1,1,1,0)\r\n        _light_color (\"Light color\", color) = (1,1,1,1)\r\n       
        _ambient_light_color (\"Ambient light color\", color) = (1,1,1,1)\r\n       
        _albedo (\"Albedo\", color) = (1,1,1,1)\r\n    }\r\n    SubShader\r\n   
        {\r\n        \r\n        Pass\r\n        {\r\n            CGPROGRAM\r\n           
        #pragma vertex vert\r\n            #pragma fragment frag\r\n            #include
        \"UnityCG.cginc\"   \r\n\r\n            float3 _world_light_direction;\r\n           
        half4 _light_color;\r\n            half4 _ambient_light_color;\r\n           
        half4 _albedo;\r\n\r\n            struct appdata {\r\n                float4
        vertex : POSITION;\r\n                float3 normal : NORMAL;\r\n           
        };\r\n\r\n            struct v2f {\r\n                float4 pos : SV_POSITION;\r\n               
        float3 worldNormal : TEXCOORD0;\r\n            };\r\n\r\n            v2f
        vert (appdata v) {\r\n                v2f o;\r\n                o.pos = UnityObjectToClipPos(v.vertex);\r\n               
        o.worldNormal = UnityObjectToWorldNormal(v.normal);\r\n                o.worldNormal
        = normalize(o.worldNormal);\r\n\r\n                return o;\r\n           
        }\r\n\r\n            half4 frag (v2f i) : SV_Target {\r\n               
        float3 worldNormal = normalize(i.worldNormal);\r\n                float3
        normalized_world_light_direction = normalize(_world_light_direction);\r\n\r\n               
        half3 NdotL = dot(worldNormal, normalized_world_light_direction);\r\n               
        NdotL = saturate(NdotL);\r\n\r\n                half3 diffuse = NdotL * _light_color.rgb;\r\n               
        \r\n                half3 color = half3((diffuse + _ambient_light_color)
        * _albedo);\r\n                return half4(color, 1.0);\r\n            }\r\n           
        ENDCG\r\n        }\r\n    }\r\n}\u200B"
