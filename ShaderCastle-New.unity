    - target: {fileID: 3566760895121587922, guid: fe72e354ba5b33c4889785ac04dfaeb7,
        type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Shader</color> <color=#D69D85>\"ShaderCastle/Tutorials/ProceduralTextures/ValueNoise2D\"</color>\r\n{\r\n   
        <color=#569CD6>Properties</color>\r\n    {\r\n        _zoom (<color=#D69D85>\"Zoom\"</color>,
        <color=#569CD6>float</color>) = 1\r\n    }\r\n    <color=#569CD6>SubShader</color>\r\n   
        {\r\n        <color=#569CD6>Pass</color>\r\n        {\r\n            <color=#569CD6>CGPROGRAM</color>\r\n           
        #pragma <color=#569CD6>vertex</color> vert\r\n            #pragma <color=#569CD6>fragment</color>
        frag\r\n            #pragma target 3.5\r\n\r\n            <color=#569CD6>float</color>
        _zoom;\r\n\r\n            <color=#569CD6>struct</color> <color=#569CD6>appdata</color>
        {\r\n                <color=#569CD6>float4</color> <color=#569CD6>vertex</color>
        : POSITION;\r\n            };\r\n\r\n            <color=#569CD6>struct</color>
        <color=#569CD6>v2f</color> {\r\n                <color=#569CD6>float4</color>
        pos : SV_POSITION;\r\n                <color=#569CD6>float4</color> <color=#569CD6>vertex</color>
        : TEXCOORD0;\r\n            };\r\n\r\n            <color=#569CD6>v2f</color>
        vert (<color=#569CD6>appdata</color> v) {\r\n                <color=#569CD6>v2f</color>
        o;\r\n                o.<color=#569CD6>vertex</color> = v.<color=#569CD6>vertex</color>;\r\n               
        o.pos = UnityObjectToClipPos(v.<color=#569CD6>vertex</color>);\r\n               
        return o;\r\n            }\r\n\r\n            <color=#569CD6>float</color>
        hash11(<color=#569CD6>float</color> p) {\r\n\r\n                if(p == -0)\r\n                   
        p = 0;\r\n\r\n                uint h = asuint(p+0.0);\r\n\r\n               
        h ^= 0x27D4EB2DU; \r\n\r\n                h = h * 1103515245U + 12345U;\r\n               
        h ^= (h >> 16);\r\n                h *= 0x85ebca6bU;\r\n                h
        ^= (h >> 13);\r\n                h *= 0xc2b2ae35U;\r\n                h ^=
        (h >> 16);\r\n\r\n                return <color=#569CD6>float</color>(h &
        0x00ffffffu) / <color=#569CD6>float</color>(0x01000000u);\r\n           
        }\r\n\r\n            <color=#569CD6>float</color> hash21(<color=#569CD6>float2</color>
        p) {\r\n                return hash11(hash11(p.x) + p.y);\r\n           
        }\r\n            \r\n            <color=#569CD6>float</color> valueNoise(<color=#569CD6>float2</color>
        uv) {\r\n                <color=#57A64A>// Base parameters\r</color>\n\t\t\t\t<color=#569CD6>float2</color>
        i = floor(uv);\r\n\t\t\t\t<color=#569CD6>float2</color> f = frac(uv);\r\n               
        <color=#569CD6>float2</color> u = f*f*(3.0-2.0*f); <color=#57A64A>// Smoothstep
        between 0...1\r</color>\n\r\n                <color=#57A64A>// Random weights\r</color>\n               
        <color=#569CD6>float</color> a = hash21(i + <color=#569CD6>float2</color>(0.0,
        0.0));\r\n                <color=#569CD6>float</color> b = hash21(i + <color=#569CD6>float2</color>(1.0,
        0.0));\r\n                <color=#569CD6>float</color> c = hash21(i + <color=#569CD6>float2</color>(0.0,
        1.0));\r\n                <color=#569CD6>float</color> d = hash21(i + <color=#569CD6>float2</color>(1.0,
        1.0));\r\n\r\n                <color=#57A64A>// Bilinear interpolation\r</color>\n\t\t\t\t<color=#569CD6>float</color>
        bottom = lerp(a, b, u.x);\r\n\t\t\t\t<color=#569CD6>float</color> top = lerp(c,
        d, u.x);\r\n\t\t\t\treturn lerp(bottom, top, u.y);\r\n\t\t\t}\r\n           
        \r\n            <color=#569CD6>half4</color> frag (<color=#569CD6>v2f</color>
        i) : SV_Target {\r\n                <color=#569CD6>float2</color> pos2D =
        i.<color=#569CD6>vertex</color>.xy;\r\n                pos2D *= _zoom;\r\n\r\n               
        <color=#569CD6>float</color> noise = valueNoise(pos2D);\r\n\r\n               
        <color=#569CD6>half3</color> color = noise.xxx;\r\n\r\n                return
        <color=#569CD6>half4</color>(color.rgb, 1.0);\r\n            }\r\n\r\n           
        <color=#569CD6>ENDCG</color>\r\n        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
