--- !u!1001 &1389716076
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1710357101}
    m_Modifications:
    - target: {fileID: 707830014532808122, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_Material
      value: 
      objectReference: {fileID: 2100000, guid: 35630e38b4e5ffb40b44ec5348b4333f, type: 2}
    - target: {fileID: 1169621769550021016, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_AnchorMax.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1169621769550021016, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1169621769550021016, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_AnchorMin.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1415808747208185003, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_Text
      value: "Shader \"ShaderCastle/Tutorials/ProceduralTextures/GridSkew\"\r\n{\r\n   
        Properties\r\n    {\r\n        _zoom (\"Zoom\", float) = 1\r\n    }\r\n   
        SubShader\r\n    {\r\n        Pass\r\n        {\r\n            CGPROGRAM\r\n           
        #pragma vertex vert\r\n            #pragma fragment frag\r\n\r\n           
        float _zoom;\r\n\r\n            struct appdata {\r\n                float4
        vertex : POSITION;\r\n            };\r\n\r\n            struct v2f {\r\n               
        float4 pos : SV_POSITION;\r\n                float4 vertex : TEXCOORD0;\r\n           
        };\r\n\r\n            v2f vert (appdata v) {\r\n                v2f o;\r\n               
        o.vertex = v.vertex;\r\n                o.pos = UnityObjectToClipPos(v.vertex);\r\n               
        return o;\r\n            }\r\n            \r\n            float stepPattern(float
        x){\r\n                float y = frac(x * 0.5);\r\n                y -= 0.5;\r\n               
        y = sign(y);\r\n                y = saturate(y);\r\n                return
        y;\r\n            }\r\n\r\n            half4 frag (v2f i) : SV_Target {\r\n               
        float2 pos2D = i.vertex.xy;\r\n                pos2D *= _zoom;\r\n\r\n               
        // Simplex Skew Factor for 2D: (sqrt(3.0) - 1.0) / 2.0\r\n               
        const float F2 = 0.366025403;\r\n                \r\n                // 1.
        Calculate the skew amount based on the sum of components\r\n               
        float skew = (pos2D.x + pos2D.y) * F2;\r\n                \r\n               
        // 2. Add the skew to the original coordinates to warp the space\r\n               
        float2 skewedPos = pos2D + skew;\r\n\r\n                half3 black = half3(0.0,
        0.0, 0.0);\r\n                half3 white = half3(1.0, 1.0, 1.0);\r\n               
        \r\n                // 3. Generate the grid pattern using the skewed coordinates\r\n               
        float xStep = stepPattern(skewedPos.x);\r\n                float yStep =
        stepPattern(-skewedPos.y);\r\n                float pattern = abs(xStep -
        yStep);\r\n\r\n                half3 color = lerp(black, white, pattern);\r\n\r\n               
        return half4(color, 1.0);\r\n            }\r\n            ENDCG\r\n       
        }\r\n    }\r\n}\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1496588037925710651, guid: 3b78f404deb68354e9b08eaf5d093c61,
        type: 3}
      propertyPath: m_Material
      value: 
      objectReference: {fileID: 2100000, guid: 35630e38b4e5ffb40b44ec5348b4333f, type: 2}
